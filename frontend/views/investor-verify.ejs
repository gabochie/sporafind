      <a href="/changelog.html" data-nav="changelog">Changelog</a>
    </div>
    <div class="nav-cta">
      <a href="/workspace.html" class="btn-ghost-nav">Sign in</a>
      <a href="/pricing.html" class="btn-primary-nav">Get early access →</a>
    </div>
    <button class="nav-mobile-toggle" id="navToggle" aria-label="Toggle menu"><i class="ti ti-menu-2"></i></button>
  </div>
</nav>
<script>
(function(){if(window.__sfNavBound)return;window.__sfNavBound=true;
document.addEventListener('click',function(e){
  var b=e.target.closest?e.target.closest('#navToggle'):null;if(!b)return;
  var l=document.querySelector('.nav-links');if(!l)return;
  l.classList.toggle('open');
  var i=b.querySelector('i');if(i)i.className=l.classList.contains('open')?'ti ti-x':'ti ti-menu-2';
});})();
</script>
<!--CHROME:HEADER:END-->
<div class="card">
  <div class="spinner"><i class="ti ti-loader"></i></div>
  <h1>Verifying access...</h1>
  <p>Please wait while we confirm your investor credentials.</p>
</div>
<script>
(function() {
  const token = localStorage.getItem('sf_investor_token');
  if (!token) {
    window.location.href = '/investors/login';
    return;
  }
  window.location.href = '/investors/dashboard';
})();
</script>
