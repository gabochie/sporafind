<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script src="/js/session.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
<title>Sporafind — Verifying Access</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap');
*{box-sizing:border-box;margin:0;padding:0}
:root{--s0:#0f0f0f;--s1:#1a1a1a;--s2:#242424;--bd:#2a2a2a;--t1:#e8e8e8;--t2:#a0a0a0;--tm:#666;--gl:#00a85a;--green:#006B3C;--gold:#D4A017;--red:#ef4444}
body{font-family:'Inter',sans-serif;background:var(--s0);color:var(--t1);min-height:100vh;display:flex;align-items:center;justify-content:center;line-height:1.5}
.card{background:var(--s1);border:1px solid var(--bd);border-radius:12px;padding:40px 32px;max-width:400px;width:100%;margin:24px;text-align:center}
h1{font-family:'JetBrains Mono',monospace;font-size:18px;font-weight:700;margin-bottom:8px;color:var(--gl)}
p{font-size:13px;color:var(--t2);margin-bottom:16px;line-height:1.6}
.spinner i{font-size:32px;color:var(--gl);animation:spin 1s linear infinite;display:inline-block;margin-bottom:16px}
@keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
<body>
<div class="card">
  <div class="spinner"><i class="ti ti-loader"></i></div>
  <h1>Verifying access...</h1>
  <p>Please wait while we confirm your investor credentials.</p>
</div>
<script>
(function() {
  const token = localStorage.getItem('sf_investor_token');
  if (!token) {
    window.location.href = '/investors/login';
    return;
  }
  window.location.href = '/investors/dashboard';
})();
</script>
</body>
</html>
