<title>Sporafind — Pitch Deck</title>
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/components.css">
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap');
*{box-sizing:border-box;margin:0;padding:0}

body{font-family:'Inter',sans-serif;background:var(--s0);color:var(--t1);padding:0;line-height:1.5;overflow:hidden;height:100vh;display:flex;flex-direction:column}
a{color:var(--gl);text-decoration:none}
.slide{flex:1;display:none;flex-direction:column;justify-content:center;align-items:center;padding:48px 64px;overflow-y:auto}
.slide.active{display:flex}
.slide-content{max-width:800px;width:100%}
h1{font-family:'JetBrains Mono',monospace;font-size:36px;font-weight:700;letter-spacing:-1px;margin-bottom:16px}
h1 span{color:var(--gold)}
h2{font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:700;margin-bottom:16px}
h2 span{color:var(--gold)}
h3{font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:600;margin-bottom:8px;color:var(--gl)}
p{font-size:15px;color:var(--t2);line-height:1.7;margin-bottom:12px;max-width:640px}
.big-num{font-family:'JetBrains Mono',monospace;font-size:64px;font-weight:700;color:var(--gl);display:block}
.big-num.gold{color:var(--gold)}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:16px 0}
.card{background:var(--s1);border:1px solid var(--bd);border-radius:10px;padding:20px}
.card p{font-size:13px;margin-bottom:0}
.tagline{font-size:18px;color:var(--gl);font-weight:500;margin-bottom:8px}
.slide-num{position:fixed;bottom:24px;right:24px;font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--tm)}
.nav-bar{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);display:flex;gap:8px;align-items:center;background:var(--s1);border:1px solid var(--bd);border-radius:20px;padding:8px 16px}
.nav-bar button{background:none;border:none;color:var(--t2);cursor:pointer;font-size:18px;padding:4px 8px;border-radius:4px;transition:all .15s;display:flex;align-items:center;justify-content:center}
.nav-bar button:hover{background:var(--s2);color:var(--t1)}
.nav-bar button:disabled{opacity:0.3;cursor:default}
.nav-bar .dots{display:flex;gap:4px;margin:0 8px}
.nav-bar .dot{width:8px;height:8px;border-radius:50%;background:var(--s3);border:none;cursor:pointer;padding:0;transition:all .15s}
.nav-bar .dot.active{background:var(--gl);width:20px;border-radius:4px}
.slide-title{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--tm);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px}
@media(max-width:640px){
  .slide{padding:32px 20px}
  h1{font-size:24px}
  .big-num{font-size:40px}
  .grid-2{grid-template-columns:1fr}
  .nav-bar{padding:6px 12px}
}
</style>
