<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<!--CHROME:HEAD:START-->
<!-- SPORAFIND PWA HEAD — single source of truth.
     Managed by scripts/build-chrome.js. Push reads its VAPID key from
     GET /api/push/vapid-key at subscribe time (503 until configured). -->
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#080D1A">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Sporafind">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<script src="/js/pwa.js" defer></script>
<!--CHROME:HEAD:END-->
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script src="/js/session.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
<title>Sporafind — Financial Model</title>
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/components.css">
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap');
*{box-sizing:border-box;margin:0;padding:0}

body{font-family:'Inter',sans-serif;background:var(--s0);color:var(--t1);padding:0;line-height:1.5}
a{color:var(--gl);text-decoration:none}
.section{max-width:1060px;margin:0 auto;padding:48px 24px}
h1{font-family:'JetBrains Mono',monospace;font-size:28px;font-weight:700;letter-spacing:-1px}
h1 span{color:var(--gold)}
h2{font-family:'JetBrains Mono',monospace;font-size:18px;font-weight:700;margin:0 0 16px}
h2 i{color:var(--gold);margin-right:6px}
.hero{background:linear-gradient(135deg,#0a1a2e,#1a2e1a);padding:48px 24px;text-align:center;border-bottom:1px solid var(--gl)}
.hero .subtitle{color:var(--t2);font-size:14px;max-width:640px;margin:8px auto 0}
.metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin:24px 0}
.card{background:var(--s1);border:1px solid var(--bd);border-radius:10px;padding:20px}
.card .big{font-family:'JetBrains Mono',monospace;font-size:36px;font-weight:700;color:var(--gl);display:block}
.card .big.gold{color:var(--gold)}
.card .big.blue{color:var(--blue)}
.card .big.red{color:var(--red)}
.card p{font-size:11px;color:var(--tm);margin-top:4px}
.chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:20px 0}
.chart-box{background:var(--s1);border:1px solid var(--bd);border-radius:10px;padding:20px}
.chart-box.full{grid-column:1/-1}
.chart-box canvas{max-height:300px;max-width:100%}
table{width:100%;border-collapse:collapse;font-size:12px;margin:12px 0}
th{text-align:left;padding:10px 12px;color:var(--tm);font-weight:600;text-transform:uppercase;font-size:10px;letter-spacing:.5px;border-bottom:1px solid var(--bd)}
td{padding:10px 12px;border-bottom:1px solid var(--s2);color:var(--t2)}
td.num{font-family:'JetBrains Mono',monospace;text-align:right;color:var(--t1)}
tr.highlight td{background:rgba(0,168,90,0.06);color:var(--gl);font-weight:600}
tr.total td{border-top:2px solid var(--gl);font-weight:700;color:var(--t1)}
.assumptions{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:16px 0}
.assumption-item{background:var(--s2);border:1px solid var(--bd);border-radius:8px;padding:14px;display:flex;justify-content:space-between;align-items:center}
.assumption-item .ai-label{font-size:11px;color:var(--t2)}
.assumption-item .ai-val{font-family:'JetBrains Mono',monospace;font-size:14px;color:var(--gl)}
input[type=range]{width:120px;accent-color:var(--gl);cursor:pointer}
input[type=number]{width:80px;background:var(--s0);border:1px solid var(--bd);border-radius:4px;color:var(--t1);padding:4px 6px;font-family:'JetBrains Mono',monospace;font-size:12px;text-align:right}
input[type=number]:focus{outline:none;border-color:var(--gl)}
.bottom-nav{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:32px;padding:24px 0 0;border-top:1px solid var(--bd)}
.page-link{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:500;color:var(--t2);padding:8px 14px;background:var(--s1);border:1px solid var(--bd);border-radius:8px;transition:all .15s;text-decoration:none}
.page-link:hover{background:var(--s2);color:var(--t1);border-color:var(--bds);text-decoration:none}
.page-link i{color:var(--gl)}
@media(max-width:640px){
  .chart-grid,.assumptions{grid-template-columns:1fr}
  .metrics-grid{grid-template-columns:repeat(2,1fr)}
  h1{font-size:22px}
  .section{padding:32px 16px}
  input[type=range]{width:80px}
}
</style>
</head>
<body>
<div class="hero">
  <span style="font-size:11px;font-weight:600;padding:4px 12px;border-radius:20px;background:rgba(0,168,90,0.15);color:var(--gl);border:1px solid rgba(0,168,90,0.3)">&#9889; Interactive Financial Model</span>
  <h1 style="margin-top:12px">Sporafind <span>Financial Projections</span></h1>
  <p class="subtitle">Three-year financial model with adjustable assumptions. Click and drag sliders to see how changes affect revenue, costs, and runway.</p>
</div>

<div class="section">
  <h2><i class="ti ti-sliders"></i> Key Assumptions</h2>
  <div class="assumptions">
    <div class="assumption-item"><div class="ai-label">Pro subscribers (Year 1)</div><div><input type="range" id="a-pro" min="10" max="500" value="80"> <span class="ai-val" id="v-pro">80</span></div></div>
    <div class="assumption-item"><div class="ai-label">Enterprise subscribers (Y1)</div><div><input type="range" id="a-enterprise" min="2" max="50" value="10"> <span class="ai-val" id="v-enterprise">10</span></div></div>
    <div class="assumption-item"><div class="ai-label">Annual growth rate</div><div><input type="range" id="a-growth" min="20" max="200" value="80"> <span class="ai-val" id="v-growth">80</span>%</div></div>
    <div class="assumption-item"><div class="ai-label">Monthly burn (opex)</div><div><input type="number" id="a-burn" value="8000" step="1000" min="2000" max="30000"> <span class="ai-val">$</span></div></div>
  </div>

  <div class="metrics-grid" id="revenue-metrics">
    <div class="card"><span class="big" id="r1">$27.8K</span><p>Year 1 Revenue</p></div>
    <div class="card"><span class="big gold" id="r2">$138.7K</span><p>Year 2 Revenue</p></div>
    <div class="card"><span class="big blue" id="r3">$427.2K</span><p>Year 3 Revenue</p></div>
    <div class="card"><span class="big red" id="runway">18.8</span><p>Runway (months) with $100K raise</p></div>
  </div>

  <div class="chart-grid">
    <div class="chart-box full">
      <h2><i class="ti ti-chart-line"></i> Revenue Projection</h2>
      <canvas id="revenueChart"></canvas>
    </div>
    <div class="chart-box">
      <h2><i class="ti ti-chart-pie"></i> Year 3 Revenue Mix</h2>
      <canvas id="mixChart"></canvas>
    </div>
    <div class="chart-box">
      <h2><i class="ti ti-currency-dollar"></i> Unit Economics</h2>
      <table>
        <tr><th>Metric</th><th class="num">Pro</th><th class="num">Enterprise</th></tr>
        <tr><td>Monthly price</td><td class="num">$29</td><td class="num">$99</td></tr>
        <tr><td>Annual price (2mo free)</td><td class="num">$290</td><td class="num">$990</td></tr>
        <tr><td>Est. CAC</td><td class="num">$50</td><td class="num">$200</td></tr>
        <tr><td>Gross margin</td><td class="num">85%</td><td class="num">92%</td></tr>
        <tr><td>Monthly churn</td><td class="num">5%</td><td class="num">2%</td></tr>
        <tr class="total"><td>LTV (12mo)</td><td class="num">$493</td><td class="num">$1,165</td></tr>
      </table>
    </div>
  </div>

  <h2><i class="ti ti-table"></i> Full P&amp;L Projection</h2>
  <table id="pnl-table">
    <tr><th>Item</th><th class="num">Year 1</th><th class="num">Year 2</th><th class="num">Year 3</th></tr>
    <tr><td>Pro subscriptions</td><td class="num" id="pnl-pro1">$27,840</td><td class="num" id="pnl-pro2">$90,048</td><td class="num" id="pnl-pro3">$220,877</td></tr>
    <tr><td>Enterprise subscriptions</td><td class="num" id="pnl-ent1">$11,880</td><td class="num" id="pnl-ent2">$48,643</td><td class="num" id="pnl-ent3">$206,381</td></tr>
    <tr class="highlight"><td>Total Revenue</td><td class="num" id="pnl-rev1">$39,720</td><td class="num" id="pnl-rev2">$138,691</td><td class="num" id="pnl-rev3">$427,258</td></tr>
    <tr><td>Hosting & infrastructure</td><td class="num">$3,600</td><td class="num">$7,200</td><td class="num">$14,400</td></tr>
    <tr><td>API costs (OpenAI, Bright Data)</td><td class="num">$4,200</td><td class="num">$8,400</td><td class="num">$16,800</td></tr>
    <tr><td>Founder salary</td><td class="num">$48,000</td><td class="num">$60,000</td><td class="num">$80,000</td></tr>
    <tr><td>Contractors</td><td class="num">$36,000</td><td class="num">$48,000</td><td class="num">$60,000</td></tr>
    <tr><td>Marketing</td><td class="num">$2,400</td><td class="num">$12,000</td><td class="num">$24,000</td></tr>
    <tr><td>Legal & compliance</td><td class="num">$2,000</td><td class="num">$3,000</td><td class="num">$5,000</td></tr>
    <tr class="total"><td>Total Costs</td><td class="num" id="pnl-cost1">$96,200</td><td class="num" id="pnl-cost2">$138,600</td><td class="num" id="pnl-cost3">$200,200</td></tr>
    <tr><td>Net Income</td><td class="num" id="pnl-net1" style="color:var(--red)">-$56,480</td><td class="num" id="pnl-net2">$91</td><td class="num" id="pnl-net3" style="color:var(--gl)">$227,058</td></tr>
  </table>

  <div class="bottom-nav">
    <a href="/investors" class="page-link"><i class="ti ti-home"></i> Overview</a>
    <a href="/investors/metrics" class="page-link"><i class="ti ti-dashboard"></i> Metrics</a>
    <a href="/investors/deck" class="page-link"><i class="ti ti-presentation"></i> Deck</a>
    <a href="/investors/data-room" class="page-link"><i class="ti ti-file-text"></i> Data Room</a>
  </div>
</div>

<script>
function fmt(num) { return '$' + Math.round(num).toLocaleString(); }
function fmtShort(num) { if (num >= 1000000) return '$' + (num/1000000).toFixed(1) + 'M'; if (num >= 1000) return '$' + (num/1000).toFixed(1) + 'K'; return '$' + Math.round(num).toLocaleString(); }

let revenueChart, mixChart;

function calcModel() {
  const pro = parseInt(document.getElementById('a-pro').value);
  const ent = parseInt(document.getElementById('a-enterprise').value);
  const growth = parseInt(document.getElementById('a-growth').value) / 100;
  const monthlyBurn = parseInt(document.getElementById('a-burn').value);

  const proPrices = [29 * 12 * 0.833, 29 * 12, 29 * 12]; // Y1: 10mo avg (ramp), Y2-3: full year
  const entPrices = [99 * 12 * 0.833, 99 * 12, 99 * 12];

  const proSubs = [pro, pro * (1 + growth), pro * (1 + growth) * (1 + growth * 0.7)];
  const entSubs = [ent, ent * (1 + growth * 0.8), ent * (1 + growth * 0.8) * (1 + growth * 0.6)];

  const proRev = proSubs.map((s, i) => Math.round(s * proPrices[i]));
  const entRev = entSubs.map((s, i) => Math.round(s * entPrices[i]));
  const totalRev = proRev.map((v, i) => v + entRev[i]);

  // Costs scale with growth
  const baseCosts = [monthlyBurn * 12, monthlyBurn * 12 * 1.3, monthlyBurn * 12 * 1.6];
  const infraCosts = [3600, 7200, 14400];
  const apiCosts = [4200, 8400, 16800];
  const marketingCosts = [2400, 12000, 24000];
  const legalCosts = [2000, 3000, 5000];
  const totalCosts = baseCosts.map((v, i) => v + infraCosts[i] + apiCosts[i] + marketingCosts[i] + legalCosts[i]);
  const netIncome = totalRev.map((v, i) => v - totalCosts[i]);

  return { proSubs, entSubs, proRev, entRev, totalRev, totalCosts, netIncome, monthlyBurn };
}

function updateUI() {
  const d = calcModel();

  document.getElementById('v-pro').textContent = document.getElementById('a-pro').value;
  document.getElementById('v-enterprise').textContent = document.getElementById('a-enterprise').value;
  document.getElementById('v-growth').textContent = document.getElementById('a-growth').value;

  document.getElementById('r1').textContent = fmtShort(d.totalRev[0]);
  document.getElementById('r2').textContent = fmtShort(d.totalRev[1]);
  document.getElementById('r3').textContent = fmtShort(d.totalRev[2]);

  const raise = 100000;
  const avgBurn = d.monthlyBurn + 3000;
  const runway = (raise / avgBurn).toFixed(1);
  document.getElementById('runway').textContent = runway;

  // P&L table
  document.getElementById('pnl-pro1').textContent = fmt(d.proRev[0]);
  document.getElementById('pnl-pro2').textContent = fmt(d.proRev[1]);
  document.getElementById('pnl-pro3').textContent = fmt(d.proRev[2]);
  document.getElementById('pnl-ent1').textContent = fmt(d.entRev[0]);
  document.getElementById('pnl-ent2').textContent = fmt(d.entRev[1]);
  document.getElementById('pnl-ent3').textContent = fmt(d.entRev[2]);
  document.getElementById('pnl-rev1').textContent = fmt(d.totalRev[0]);
  document.getElementById('pnl-rev2').textContent = fmt(d.totalRev[1]);
  document.getElementById('pnl-rev3').textContent = fmt(d.totalRev[2]);
  document.getElementById('pnl-cost1').textContent = fmt(d.totalCosts[0]);
  document.getElementById('pnl-cost2').textContent = fmt(d.totalCosts[1]);
  document.getElementById('pnl-cost3').textContent = fmt(d.totalCosts[2]);

  const net1 = document.getElementById('pnl-net1');
  const net2 = document.getElementById('pnl-net2');
  const net3 = document.getElementById('pnl-net3');
  net1.textContent = fmt(d.netIncome[0]); net1.style.color = d.netIncome[0] < 0 ? 'var(--red)' : 'var(--gl)';
  net2.textContent = fmt(d.netIncome[1]); net2.style.color = d.netIncome[1] < 0 ? 'var(--red)' : 'var(--gl)';
  net3.textContent = fmt(d.netIncome[2]); net3.style.color = d.netIncome[2] < 0 ? 'var(--red)' : 'var(--gl)';

  // Revenue chart
  if (revenueChart) revenueChart.destroy();
  revenueChart = new Chart(document.getElementById('revenueChart'), {
    type: 'bar',
    data: {
      labels: ['Year 1', 'Year 2', 'Year 3'],
      datasets: [
        { label: 'Pro', data: d.proRev, backgroundColor: '#00a85a', borderRadius: 4 },
        { label: 'Enterprise', data: d.entRev, backgroundColor: '#D4A017', borderRadius: 4 }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: true, scales: { x: { stacked: true, ticks: { color: '#666', font: { size: 11 } }, grid: { display: false } }, y: { stacked: true, ticks: { color: '#666', font: { size: 10 }, callback: v => fmtShort(v) }, grid: { color: '#1a1a1a' } } },
      plugins: { legend: { position: 'top', labels: { color: '#a0a0a0', font: { size: 11 }, boxWidth: 12, usePointStyle: true } }, tooltip: { callbacks: { label: ctx => ctx.dataset.label + ': ' + fmt(ctx.raw) } } }
    }
  });

  // Mix chart
  if (mixChart) mixChart.destroy();
  mixChart = new Chart(document.getElementById('mixChart'), {
    type: 'doughnut',
    data: {
      labels: ['Pro', 'Enterprise'],
      datasets: [{ data: [d.proRev[2], d.entRev[2]], backgroundColor: ['#00a85a', '#D4A017'], borderWidth: 0 }]
    },
    options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom', labels: { color: '#a0a0a0', font: { size: 11 }, boxWidth: 12, padding: 12 } }, tooltip: { callbacks: { label: ctx => ctx.label + ': ' + fmt(ctx.raw) + ' (' + Math.round(ctx.raw / (d.proRev[2]+d.entRev[2]) * 100) + '%)' } } } }
  });
}

document.querySelectorAll('input').forEach(el => el.addEventListener('input', updateUI));
updateUI();
</script>
</body>
</html>
