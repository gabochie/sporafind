<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script src="/js/session.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
<title>Sporafind — Investor Overview</title>
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/components.css">
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap');
*{box-sizing:border-box;margin:0;padding:0}

body{font-family:'Inter',sans-serif;background:var(--s0);color:var(--t1);padding:0;line-height:1.5}
a{color:var(--gl);text-decoration:none}
a:hover{text-decoration:underline}
.section{max-width:960px;margin:0 auto;padding:48px 24px}
h1{font-family:'JetBrains Mono',monospace;font-size:32px;font-weight:700;letter-spacing:-1px}
h1 span{color:var(--gold)}
h2{font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:700;margin:0 0 16px}
h2 span{color:var(--gold)}
h3{font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:600;margin:0 0 8px}
.hero{background:linear-gradient(135deg,#0a2e1a,#1a3a22);padding:64px 24px;text-align:center;border-bottom:1px solid var(--green)}
.hero .subtitle{color:var(--t2);font-size:15px;max-width:640px;margin:12px auto 0;line-height:1.6}
.hero-tag{display:inline-block;font-size:11px;font-weight:600;padding:4px 12px;border-radius:20px;background:rgba(0,168,90,0.15);color:var(--gl);border:1px solid rgba(0,168,90,0.3);margin-bottom:12px}
.metrics-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-top:32px}
.metric-card{background:var(--s0);border:1px solid var(--bd);border-radius:10px;padding:16px;text-align:center}
.metric-card .m-num{font-family:'JetBrains Mono',monospace;font-size:28px;font-weight:700;color:var(--gl)}
.metric-card .m-num.loading{color:var(--tm);font-size:16px}
.metric-card .m-label{font-size:10px;color:var(--tm);text-transform:uppercase;letter-spacing:.5px;margin-top:4px}
.metric-card .m-note{font-size:9px;color:var(--t2);margin-top:2px}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:20px 0}
.card{background:var(--s1);border:1px solid var(--bd);border-radius:10px;padding:24px}
.card p{font-size:13px;color:var(--t2);line-height:1.7;margin-bottom:8px}
.card p:last-child{margin-bottom:0}
.card .big{font-family:'JetBrains Mono',monospace;font-size:42px;font-weight:700;color:var(--gl);display:block}
.card .big.gold{color:var(--gold)}
.pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:20px 0}
.plan{border:1px solid var(--bd);border-radius:10px;padding:20px;background:var(--s1);text-align:center}
.plan.highlight{border-color:var(--gl);box-shadow:0 0 0 1px var(--gl)}
.plan .pl-name{font-size:13px;font-weight:600;color:var(--t2);text-transform:uppercase;letter-spacing:1px}
.plan .pl-price{font-family:'JetBrains Mono',monospace;font-size:32px;font-weight:700;color:var(--t1);margin:8px 0 4px}
.plan .pl-price span{font-size:14px;color:var(--tm)}
.plan .pl-period{font-size:11px;color:var(--tm);margin-bottom:12px}
.plan ul{list-style:none;padding:0;text-align:left}
.plan ul li{font-size:11px;color:var(--t2);padding:4px 0;display:flex;align-items:center;gap:6px}
.plan ul li i{color:var(--gl);font-size:13px}
.funds-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:16px 0}
.fund-item{background:var(--s2);border:1px solid var(--bd);border-radius:8px;padding:12px 14px;display:flex;align-items:center;gap:10px}
.fund-item .fi-pct{font-family:'JetBrains Mono',monospace;font-size:18px;font-weight:700;color:var(--gl);min-width:48px}
.fund-item .fi-label{font-size:11px;color:var(--t2);flex:1}
.fund-item .fi-amt{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--t1)}
.cta-box{background:linear-gradient(135deg,#0a2e1a,#0a1a2e);border:1px solid var(--gl);border-radius:12px;padding:32px;text-align:center;margin-top:32px}
.cta-box h2{color:var(--gl);margin-bottom:8px}
.cta-box p{font-size:14px;color:var(--t2);margin-bottom:20px}
.cta-box .btn{display:inline-block;font-family:'Inter',sans-serif;font-size:14px;font-weight:600;padding:12px 28px;border-radius:8px;background:var(--gl);color:var(--s0);border:none;cursor:pointer;text-decoration:none;transition:all .15s}
.cta-box .btn:hover{background:#00c86e;text-decoration:none}
.cta-box .btn-secondary{background:transparent;color:var(--t1);border:1px solid var(--bd);margin-left:12px}
.cta-box .btn-secondary:hover{background:var(--s2)}
.page-link{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:500;color:var(--t2);padding:8px 14px;background:var(--s1);border:1px solid var(--bd);border-radius:8px;transition:all .15s;text-decoration:none}
.page-link:hover{background:var(--s2);color:var(--t1);text-decoration:none;border-color:var(--bds)}
.page-link i{color:var(--gl)}
.links-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;margin:16px 0}
.bottom-nav{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:24px;padding:24px 0 0;border-top:1px solid var(--bd)}
.tag{font-size:10px;font-weight:600;padding:2px 8px;border-radius:10px;display:inline-block}
.tag-live{background:#0a2e1a;color:var(--gl);border:1px solid #1a4f2a}
.tag-pending{background:#2e1a1a;color:var(--red);border:1px solid #4f2a2a}
@media(max-width:640px){
  .grid-2,.pricing-grid,.funds-grid{grid-template-columns:1fr}
  h1{font-size:24px}
  .hero{padding:40px 16px}
  .section{padding:32px 16px}
  .metrics-strip{grid-template-columns:repeat(2,1fr)}
}
</style>
</head>
<body>
<div class="hero">
  <div class="hero-tag">⚡ Pre-seed · $50-150K · Phase A Complete</div>
  <h1>Sporafind <span>Intelligence Database</span><br>of the African Diaspora</h1>
  <p class="subtitle">A searchable intelligence platform connecting investment syndicates with diaspora professionals. Live at sporafind.com — built, tested, and deployed on Vercel with real data.</p>
  <div class="metrics-strip">
    <div class="metric-card"><div class="m-num" id="m-profiles" data-metric="total_profiles">—</div><div class="m-label">Diaspora profiles</div><div class="m-note">from Companies House</div></div>
    <div class="metric-card"><div class="m-num" id="m-orgs" data-metric="total_orgs">—</div><div class="m-label">Organisations</div><div class="m-note">linked to profiles</div></div>
    <div class="metric-card"><div class="m-num" id="m-countries" data-metric="total_countries">—</div><div class="m-label">Countries</div><div class="m-note">diaspora footprint</div></div>
    <div class="metric-card"><div class="m-num" id="m-tests" data-metric="tests">35</div><div class="m-label">Automated tests</div><div class="m-note">pytest + vitest · CI/CD</div></div>
    <div class="metric-card"><div class="m-num" id="m-tiers" data-metric="pricing_tiers">—</div><div class="m-label">Pricing tiers</div><div class="m-note">$0 / $29 / $99</div></div>
    <div class="metric-card"><div class="m-num" id="m-deploy" data-metric="deployment">Vercel</div><div class="m-label">Deployment</div><div class="m-note">serverless · auto-scaled</div></div>
  </div>
</div>

<div class="section">
  <h2><span>◆</span> The Problem</h2>
  <div class="grid-2">
    <div class="card">
      <span class="big">$15B+</span>
      <p>Annual remittances from the Ghanaian diaspora — yet investment syndicates have no tool to find, research, or connect with these professionals. Deal sourcing is manual, slow, and limited to personal networks.</p>
    </div>
    <div class="card">
      <span class="big gold">Millions</span>
      <p>Of diaspora professionals across finance, tech, real estate, and healthcare who want to invest in and contribute to their home economies — but have no platform to be discovered for opportunities.</p>
    </div>
  </div>

  <h2 style="margin-top:32px"><span>◆</span> The Solution</h2>
  <div class="card" style="margin-bottom:20px">
    <p><strong>Sporafind</strong> is a searchable intelligence database of the Ghanaian/African diaspora. Investment syndicates use it to discover diaspora investors, track capital flows, and source deal partners. Diaspora members claim their profiles and opt into the network.</p>
    <p style="margin-top:8px">Phase A (Intelligence Platform) is <strong>live and deployed</strong>. Phase B (Claim + Verify) lets diaspora members claim their scraped profiles. Phase C adds paid connections. Phase D expands pan-African.</p>
  </div>

  <div class="cta-box" style="margin-top:32px">
    <h2>🚀 Investor Portal</h2>
    <p>Detailed investor resources — pitch deck, financial model, live metrics dashboard, and data room — are available by invitation through the Sporafind Investor Portal.</p>
    <a href="/investors/login" class="btn">🔐 Request Access</a>
    <a href="mailto:founder@sporafind.com" class="btn btn-secondary">📧 Contact Founder</a>
  </div>

  <p style="text-align:center;font-size:10px;color:var(--tm);margin-top:24px"><a href="https://sporafind.com">sporafind.com</a> · Phase A · Deployed on Vercel · Built by a solo founder · This page is for informational purposes only. Investor resources are available by invitation.</p>
</div>

<script>
async function loadMetrics(){
  try {
    const r = await fetch('/api/stats/public-metrics');
    const d = await r.json();
    for(const [key, value] of Object.entries(d)){
      const el = document.querySelector(`[data-metric="${key}"]`);
      if(el) {
        if(typeof value === 'number') el.textContent = value.toLocaleString();
        else if(typeof value === 'boolean') el.textContent = value ? '✓' : '—';
        else el.textContent = value;
      }
    }
  } catch(e) {
    document.querySelectorAll('[data-metric]').forEach(el => {
      if(el.textContent === '—' || el.textContent === '...') el.textContent = '—';
    });
  }
}
loadMetrics();
</script>
</body>
</html>
