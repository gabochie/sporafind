<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/tabler-icons.min.css">
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/components.css">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text-dark);line-height:1.6;-webkit-font-smoothing:antialiased}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px;border-radius:4px}

/* Nav + footer come from shared chrome: /css/components.css */

/* ---------- Hero ---------- */
.blog-hero{background:var(--navy);padding:72px 48px 84px;position:relative;overflow:hidden}
.hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.03) 1px,transparent 1px);background-size:60px 60px;pointer-events:none}
.hero-glow{position:absolute;top:-40%;left:50%;transform:translateX(-50%);width:900px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(212,160,23,0.10) 0%,transparent 62%);pointer-events:none}
.blog-hero-inner{max-width:1100px;margin:0 auto;position:relative;z-index:2}
.hero-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:600;letter-spacing:1.4px;text-transform:uppercase;color:var(--gold);background:rgba(212,160,23,0.1);border:0.5px solid rgba(212,160,23,0.25);padding:6px 14px;border-radius:20px;margin-bottom:24px}
.blog-hero h1{font-family:'Space Grotesk',sans-serif;font-size:56px;font-weight:800;letter-spacing:-2px;line-height:1.06;color:#fff;margin-bottom:16px}
.blog-hero h1 span{color:var(--gold)}
.blog-hero-sub{font-size:18px;line-height:1.7;color:rgba(255,255,255,0.55);max-width:620px}
.hero-stats{display:flex;flex-wrap:wrap;gap:32px;margin-top:36px;padding-top:28px;border-top:0.5px solid rgba(255,255,255,0.08)}
.hero-stat{display:flex;flex-direction:column;gap:2px}
.hero-stat b{font-family:'Space Grotesk',sans-serif;font-size:24px;font-weight:700;color:#fff;letter-spacing:-0.5px}
.hero-stat span{font-size:12px;color:rgba(255,255,255,0.4);text-transform:uppercase;letter-spacing:1px}
.hero-stat a{color:var(--gold);text-decoration:none}
.hero-stat a:hover{text-decoration:underline}

/* ---------- Shell + sticky toolbar ---------- */
.blog-shell{max-width:1200px;margin:0 auto;padding:0 48px 96px}
.blog-toolbar{position:sticky;top:64px;z-index:60;display:flex;align-items:center;gap:20px;flex-wrap:wrap;padding:16px 0;margin-bottom:4px;background:rgba(244,246,249,0.92);backdrop-filter:blur(10px);border-bottom:0.5px solid var(--cream2)}
.blog-search{display:flex;align-items:center;gap:10px;flex:1;min-width:280px;max-width:460px;background:var(--white);border:0.5px solid var(--cream2);border-radius:var(--radius);padding:0 6px 0 14px;height:44px;transition:border-color .15s,box-shadow .15s}
.blog-search:focus-within{border-color:var(--gold);box-shadow:0 0 0 3px var(--gold-glow)}
.blog-search i{color:var(--text-muted);font-size:18px;flex-shrink:0}
.blog-search input{flex:1;min-width:0;border:none;background:transparent;font-family:'Inter',sans-serif;font-size:14px;color:var(--text-dark);outline:none}
.blog-search input::placeholder{color:var(--text-muted)}
.blog-search button{height:34px;padding:0 16px;border:none;border-radius:var(--radius-sm);background:var(--navy);color:#fff;font-family:'Inter',sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:background .15s}
.blog-search button:hover{background:var(--navy3)}
.blog-count{font-size:13px;color:var(--text-muted);margin-left:auto;white-space:nowrap}
.blog-count b{color:var(--text-dark);font-weight:600}

/* ---------- Facets ---------- */
.cat-tabs{display:flex;flex-wrap:wrap;gap:8px;padding:24px 0 4px}
.cat-tab{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:20px;font-size:13px;font-weight:500;color:var(--text-mid);background:var(--white);border:0.5px solid var(--cream2);text-decoration:none;transition:all .14s;min-height:36px}
.cat-tab:hover{border-color:var(--gold);color:var(--gold)}
.cat-tab.active{background:var(--navy);border-color:var(--navy);color:#fff;font-weight:600}
.cat-tab i{color:var(--text-muted);font-size:14px}
.cat-tab.active i{color:var(--gold)}
.cat-tab em{font-style:normal;font-size:11px;color:var(--text-muted);background:var(--bg);border-radius:10px;padding:1px 7px}
.cat-tab.active em{color:rgba(255,255,255,0.75);background:rgba(255,255,255,0.12)}

.topic-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:16px 0 0}
.topic-label{font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--text-muted);margin-right:4px}
.topic-chip{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:16px;font-size:12px;color:var(--text-mid);background:var(--white);border:0.5px solid var(--cream2);text-decoration:none;transition:all .14s}
.topic-chip:hover{border-color:var(--green);color:var(--green);background:var(--green-light)}
.topic-chip.active{background:var(--green);border-color:var(--green);color:#fff;font-weight:600}
.topic-chip b{font-weight:500;font-size:11px;opacity:0.6}

.active-filters{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:20px 0 0;font-size:13px;color:var(--text-mid)}
.filter-pill{display:inline-flex;align-items:center;gap:8px;padding:6px 8px 6px 14px;border-radius:20px;background:var(--gold-light);border:0.5px solid rgba(212,160,23,0.35);color:var(--amber);font-weight:500}
.filter-pill i{font-size:15px}
.filter-clear{font-size:13px;color:var(--text-muted);text-decoration:none;border-bottom:1px solid var(--cream3)}
.filter-clear:hover{color:var(--red-deep)}

/* ---------- Covers ---------- */
.cover{position:relative;overflow:hidden;background:var(--navy2);isolation:isolate}
.cover::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,0.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.05) 1px,transparent 1px);background-size:44px 44px;z-index:0}
.cover::after{content:'';position:absolute;width:240px;height:240px;right:-70px;top:-90px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,0.16) 0%,transparent 68%);z-index:0}
.cover-0{background:linear-gradient(135deg,#004d2b 0%,#006B3C 100%)}
.cover-1{background:linear-gradient(135deg,#0E1627 0%,#1C2A4A 100%)}
.cover-2{background:linear-gradient(135deg,#062F3C 0%,#0E7490 100%)}
.cover-3{background:linear-gradient(135deg,#3B1D78 0%,#7C3AED 100%)}
.cover-4{background:linear-gradient(135deg,#7A3A06 0%,#B45309 100%)}
.cover-5{background:linear-gradient(135deg,#0A1120 0%,#2A4A7C 100%)}
.cover-icon{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:76px;color:rgba(255,255,255,0.16);z-index:1}
/* Curated photography sits over the gradient; the gradient stays as the
   placeholder colour and as the scrim behind the category badge. */
.cover-photo::before,.cover-photo::after{display:none}
.cover-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;
  filter:saturate(0.92) contrast(1.04)}
.cover-photo .cat-badge{z-index:2;background:rgba(8,13,26,0.62);border-color:rgba(255,255,255,0.22)}
.photo-credit{position:absolute;right:10px;bottom:8px;z-index:2;font-size:10px;line-height:1.3;
  color:rgba(255,255,255,0.72);background:rgba(8,13,26,0.5);padding:3px 8px;border-radius:8px;
  backdrop-filter:blur(6px);max-width:78%;text-align:right}
.photo-credit a{color:rgba(255,255,255,0.86)}
.cat-badge{position:absolute;top:12px;left:12px;z-index:2;font-size:11px;font-weight:600;background:rgba(8,13,26,0.55);color:#fff;padding:5px 12px;border-radius:12px;backdrop-filter:blur(6px);border:0.5px solid rgba(255,255,255,0.14);max-width:calc(100% - 24px);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* ---------- Featured (lead) post ---------- */
.post-feature{display:grid;grid-template-columns:minmax(0,44%) minmax(0,1fr);background:var(--white);border:0.5px solid var(--cream2);border-radius:var(--radius-lg);overflow:hidden;margin-top:32px;transition:box-shadow .2s,transform .2s}
.post-feature:hover{box-shadow:var(--shadow-md);transform:translateY(-2px)}
.post-feature .cover{min-height:320px}
.post-feature-body{padding:36px 40px;display:flex;flex-direction:column;justify-content:center}
.feature-flag{display:inline-flex;align-items:center;gap:7px;align-self:flex-start;font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--green);background:var(--green-light);padding:6px 12px;border-radius:14px;margin-bottom:16px}
.post-feature-title{font-family:'Space Grotesk',sans-serif;font-size:30px;font-weight:800;line-height:1.2;letter-spacing:-1px;color:var(--navy);margin-bottom:14px}
.post-feature-excerpt{font-size:15px;line-height:1.7;color:var(--text-mid);margin-bottom:22px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.feature-meta{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--text-muted)}
.feature-meta .dot{width:3px;height:3px;border-radius:50%;background:var(--cream3)}
.feature-cta{display:inline-flex;align-items:center;gap:8px;margin-top:22px;font-family:'Space Grotesk',sans-serif;font-size:15px;font-weight:600;color:var(--green);text-decoration:none}
.feature-cta i{transition:transform .15s}
.post-feature:hover .feature-cta i{transform:translateX(3px)}

/* ---------- Grid + cards ---------- */
.blog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:32px}
.post-card{position:relative;display:flex;flex-direction:column;background:var(--white);border:0.5px solid var(--cream2);border-radius:var(--radius-md);overflow:hidden;transition:box-shadow .2s,transform .2s}
.post-card:hover{box-shadow:var(--shadow-md);transform:translateY(-2px)}
.post-card .cover{height:168px}
.post-card-body{padding:20px 22px 18px;display:flex;flex-direction:column;flex:1}
.post-card-meta{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-muted);margin-bottom:10px}
.post-card-title{font-family:'Space Grotesk',sans-serif;font-size:18px;font-weight:700;line-height:1.32;letter-spacing:-0.4px;color:var(--text-dark);margin-bottom:10px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.post-card-excerpt{font-size:14px;line-height:1.6;color:var(--text-mid);margin-bottom:16px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.post-card-foot{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:auto;padding-top:14px;border-top:0.5px solid var(--cream2)}
.post-tag{font-size:11px;color:var(--slate2);background:var(--bg);padding:3px 9px;border-radius:10px}
.post-views{font-size:11px;color:var(--text-muted);margin-left:auto;display:inline-flex;align-items:center;gap:4px;white-space:nowrap}
.post-card-link{position:absolute;inset:0;z-index:2;text-decoration:none}
.post-card-link::after{content:'';position:absolute;inset:0}

/* ---------- Pagination ---------- */
.pagination{display:flex;align-items:center;justify-content:center;gap:6px;margin-top:56px;flex-wrap:wrap}
.page-btn{min-width:40px;height:40px;padding:0 12px;border-radius:var(--radius-sm);border:0.5px solid var(--cream2);background:var(--white);color:var(--text-mid);font-family:'Inter',sans-serif;font-size:14px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;transition:all .14s}
.page-btn:hover{border-color:var(--gold);color:var(--gold-dark)}
.page-btn.active{background:var(--navy);border-color:var(--navy);color:#fff;font-weight:600}
.page-btn.disabled{opacity:0.35;pointer-events:none}
.page-gap{min-width:24px;text-align:center;color:var(--text-muted);user-select:none}
.pagination-note{text-align:center;font-size:12px;color:var(--text-muted);margin-top:14px}

/* ---------- Empty state ---------- */
.empty-state{text-align:center;padding:96px 32px;background:var(--white);border:0.5px dashed var(--cream2);border-radius:var(--radius-lg);margin-top:32px}
.empty-state i{font-size:44px;color:var(--cream3);margin-bottom:18px;display:block}
.empty-state h2{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;color:var(--navy);margin-bottom:8px}
.empty-state p{font-size:15px;color:var(--text-mid);margin-bottom:24px}
.btn-outline{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:var(--radius-sm);border:0.5px solid var(--cream2);background:var(--white);color:var(--text-dark);font-size:14px;font-weight:600;text-decoration:none;transition:all .14s;min-height:40px}
.btn-outline:hover{border-color:var(--navy);color:var(--navy)}

/* ---------- Newsletter ---------- */
.subscribe-sect{background:var(--navy);padding:72px 48px;text-align:center;position:relative;overflow:hidden}
.subscribe-inner{max-width:620px;margin:0 auto;position:relative;z-index:2}
.subscribe-sect h2{font-family:'Space Grotesk',sans-serif;font-size:32px;font-weight:800;letter-spacing:-1px;color:#fff;margin-bottom:12px}
.subscribe-sect p{color:rgba(255,255,255,0.5);margin-bottom:28px;font-size:15px;line-height:1.7}
.subscribe-trust{display:flex;align-items:center;justify-content:center;gap:20px;flex-wrap:wrap;margin-top:20px;font-size:12px;color:rgba(255,255,255,0.35)}
.subscribe-trust span{display:inline-flex;align-items:center;gap:6px}
.subscribe-trust i{color:var(--gold)}
.subscribe-form{display:flex;gap:10px;max-width:460px;margin:0 auto}
.subscribe-form input{flex:1;min-width:0;padding:13px 16px;border-radius:var(--radius-sm);border:0.5px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.06);color:#fff;font-size:14px;font-family:'Inter',sans-serif;outline:none}
.subscribe-form input::placeholder{color:var(--slate2)}
.subscribe-form input:focus{border-color:var(--gold)}
.subscribe-form button{padding:13px 28px;background:var(--gold);color:#0A0E1A;font-weight:700;border:none;border-radius:var(--radius-sm);cursor:pointer;font-family:'Inter',sans-serif;font-size:14px;white-space:nowrap;transition:background .15s}
.subscribe-form button:hover{background:var(--gold-dark)}

@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{transition:none!important;animation:none!important;scroll-behavior:auto!important}
}

@media(max-width:1200px){
  .blog-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .blog-hero h1{font-size:46px}
}
@media(max-width:900px){
  .blog-hero{padding:48px 20px 56px}
  .blog-hero h1{font-size:34px;letter-spacing:-1px}
  .blog-hero-sub{font-size:16px}
  .hero-stats{gap:20px}
  .hero-stat b{font-size:20px}
  .blog-shell{padding:0 20px 72px}
  .blog-toolbar{top:64px;padding:12px 0}
  .blog-search{max-width:none}
  .blog-count{margin-left:0;width:100%}
  .post-feature{grid-template-columns:1fr}
  .post-feature .cover{min-height:200px}
  .post-feature-body{padding:24px 22px}
  .post-feature-title{font-size:23px}
  .blog-grid{grid-template-columns:1fr}
  .subscribe-sect{padding:48px 20px}
  .subscribe-sect h2{font-size:24px}
  .subscribe-form{flex-direction:column}
}
</style>
</head>
<body>

<!--CHROME:HEADER:START-->
<!-- SPORAFIND SHARED HEADER — single source of truth.
     Managed by scripts/build-chrome.js. DO NOT edit nav copies in pages;
     edit this file then run: npm run build:chrome -->
<nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <div class="nav-logomark"><div class="nav-star"></div></div>
      <div class="nav-wordmark">Spora<span>Find</span></div>
    </a>
    <div class="nav-links">
      <a href="/features.html" data-nav="features">Features</a>
      <a href="/segments.html" data-nav="segments">Segments</a>
      <a href="/pricing.html" data-nav="pricing">Pricing</a>
      <a href="/api-docs.html" data-nav="api-docs">API docs</a>
      <a href="/changelog.html" data-nav="changelog">Changelog</a>
    </div>
    <div class="nav-cta">
      <a href="/workspace.html" class="btn-ghost-nav">Sign in</a>
      <a href="/pricing.html" class="btn-primary-nav">Get early access →</a>
    </div>
    <button class="nav-mobile-toggle" id="navToggle" aria-label="Toggle menu"><i class="ti ti-menu-2"></i></button>
  </div>
</nav>
<script>
(function(){if(window.__sfNavBound)return;window.__sfNavBound=true;
document.addEventListener('click',function(e){
  var b=e.target.closest?e.target.closest('#navToggle'):null;if(!b)return;
  var l=document.querySelector('.nav-links');if(!l)return;
  l.classList.toggle('open');
  var i=b.querySelector('i');if(i)i.className=l.classList.contains('open')?'ti ti-x':'ti ti-menu-2';
});})();
</script>
<!--CHROME:HEADER:END-->

<%
  var compact = new Intl.NumberFormat('en',{notation:'compact',maximumFractionDigits:1});
  var isFiltered = !!(q || tag || cat);
  var showFeature = posts.length > 0 && page === 1 && !isFiltered;
  var grid = showFeature ? posts.slice(1) : posts;
%>

<section class="blog-hero">
  <div class="hero-grid"></div>
  <div class="hero-glow"></div>
  <div class="blog-hero-inner">
    <span class="hero-eyebrow"><i class="ti ti-radar-2"></i> Diaspora Intelligence</span>
    <h1>Field reports for the <span>Ghanaian diaspora</span></h1>
    <p class="blog-hero-sub">Evidence-based analysis on money, markets, migration and professional networks — written for operators, investors and institutions.</p>
    <div class="hero-stats">
      <div class="hero-stat"><b><%= total %></b><span>Articles</span></div>
      <div class="hero-stat"><b><%= categories.length %></b><span>Categories</span></div>
      <div class="hero-stat"><b><%= tagTotal %></b><span>Topics</span></div>
      <div class="hero-stat"><b><a href="/rss.xml"><i class="ti ti-rss"></i> RSS</a></b><span>Follow along</span></div>
    </div>
  </div>
</section>

<div class="blog-shell">

  <div class="blog-toolbar">
    <form class="blog-search" action="/blog" method="get" role="search">
      <% if(cat){ %><input type="hidden" name="cat" value="<%= cat %>"><% } %>
      <% if(tag){ %><input type="hidden" name="tag" value="<%= tag %>"><% } %>
      <i class="ti ti-search"></i>
      <input type="search" name="q" value="<%= q || '' %>" placeholder="Search <%= total %> articles…" aria-label="Search articles">
      <button type="submit">Search</button>
    </form>
    <div class="blog-count">
      <% if(total > 0){ %>
        <b><%= (page - 1) * 9 + 1 %>–<%= Math.min(page * 9, total) %></b> of <b><%= total %></b> <%= total === 1 ? 'article' : 'articles' %>
        <% if(isFiltered){ %> matching<% } %>
      <% } else { %>No articles<% } %>
    </div>
  </div>

  <nav class="cat-tabs" aria-label="Filter by category">
    <a href="/blog<%= (tag||q) ? blogQs({page:0,cat:'',tag:'',q:''}) : '' %>" class="cat-tab <%= !cat ? 'active' : '' %>">
      <i class="ti ti-layout-grid"></i> All categories
    </a>
    <% categories.forEach(function(c){ %>
      <a href="/blog?cat=<%= encodeURIComponent(c) %><%= tag ? '&tag='+encodeURIComponent(tag) : '' %><%= q ? '&q='+encodeURIComponent(q) : '' %>" class="cat-tab <%= cat === c ? 'active' : '' %>">
        <%= c %> <em><%= categoryCounts[c] || 0 %></em>
      </a>
    <% }) %>
  </nav>

  <% if(tags.length){ %>
  <div class="topic-row">
    <span class="topic-label">Topics</span>
    <% tags.forEach(function(t){ %>
      <a href="/blog?tag=<%= encodeURIComponent(t.name) %><%= cat ? '&cat='+encodeURIComponent(cat) : '' %><%= q ? '&q='+encodeURIComponent(q) : '' %>" class="topic-chip <%= tag === t.name ? 'active' : '' %>">#<%= t.name %> <b><%= t.count %></b></a>
    <% }) %>
  </div>
  <% } %>

  <% if(isFiltered){ %>
  <div class="active-filters">
    <span>Filtering by</span>
    <% if(q){ %><span class="filter-pill">“<%= q %>” <i class="ti ti-x"></i></span><% } %>
    <% if(cat){ %><span class="filter-pill"><%= cat %> <i class="ti ti-x"></i></span><% } %>
    <% if(tag){ %><span class="filter-pill">#<%= tag %> <i class="ti ti-x"></i></span><% } %>
    <a href="/blog" class="filter-clear">Clear all</a>
  </div>
  <% } %>

  <% if(posts.length === 0){ %>
    <div class="empty-state">
      <i class="ti ti-article-off"></i>
      <h2>Nothing matched that search</h2>
      <p>We could not find an article for this combination. Try a broader term or reset the filters.</p>
      <a href="/blog" class="btn-outline"><i class="ti ti-refresh"></i> Browse all articles</a>
    </div>
  <% } else { %>

    <% if(showFeature){ var f = posts[0]; %>
    <a href="/blog/<%= f.slug %>" class="post-feature">
<div class="cover cover-<%= f.coverTheme %><%= f.featureImage ? ' cover-photo' : '' %>">
        <% if (f.featureImage) { %>
          <img class="cover-img" src="<%= f.featureImage %>" alt="<%= f.featureImageAlt %>"
               width="1200" height="630" loading="eager" decoding="async" fetchpriority="high">
          <span class="photo-credit">Photo: <%= f.featureImageCredit %></span>
        <% } %>
        <span class="cat-badge"><%= f.category %></span>
        <% if (!f.featureImage) { %><i class="ti <%= f.coverIcon %> cover-icon"></i><% } %>
      </div>
      <div class="post-feature-body">
        <span class="feature-flag"><i class="ti ti-sparkles"></i> Latest</span>
        <h2 class="post-feature-title"><%= f.title %></h2>
        <p class="post-feature-excerpt"><%= f.excerpt %></p>
        <div class="feature-meta">
          <span><%= f.dateLabel %></span><span class="dot"></span>
          <span><%= f.readMinutes %> min read</span><span class="dot"></span>
          <span><i class="ti ti-eye"></i> <%= compact.format(f.views) %></span>
        </div>
        <span class="feature-cta">Read the report <i class="ti ti-arrow-right"></i></span>
      </div>
    </a>
    <% } %>

    <% if(grid.length){ %>
    <div class="blog-grid">
      <% grid.forEach(function(p){ %>
        <article class="post-card">
<div class="cover cover-<%= p.coverTheme %><%= p.featureImage ? ' cover-photo' : '' %>">
                <% if (p.featureImage) { %>
                  <img class="cover-img" src="<%= p.featureImage %>" alt="<%= p.featureImageAlt %>"
                       width="1200" height="630" loading="lazy" decoding="async">
                  <span class="photo-credit">Photo: <%= p.featureImageCredit %></span>
                <% } %>
                <span class="cat-badge"><%= p.category %></span>
                <% if (!p.featureImage) { %><i class="ti <%= p.coverIcon %> cover-icon"></i><% } %>
              </div>
          <div class="post-card-body">
            <div class="post-card-meta">
              <time datetime="<%= p.publishedAt %>"><%= p.dateLabel %></time>
              <span>·</span>
              <span><%= p.readMinutes %> min read</span>
            </div>
            <h3 class="post-card-title"><%= p.title %></h3>
            <p class="post-card-excerpt"><%= p.excerpt %></p>
            <div class="post-card-foot">
              <% (p.tags||[]).slice(0,2).forEach(function(t){ %>
                <span class="post-tag">#<%= t %></span>
              <% }) %>
              <span class="post-views"><i class="ti ti-eye"></i> <%= compact.format(p.views) %></span>
            </div>
          </div>
          <a class="post-card-link" href="/blog/<%= p.slug %>"><span class="sr-only">Read “<%= p.title %>”</span></a>
        </article>
      <% }) %>
    </div>
    <% } %>

    <% if(totalPages > 1){ %>
      <nav class="pagination" aria-label="Pagination">
        <a href="/blog<%= blogQs({page: page - 1}) %>" class="page-btn <%= page <= 1 ? 'disabled' : '' %>" aria-label="Previous page" rel="prev"><i class="ti ti-chevron-left"></i></a>
        <% pageWindow.forEach(function(w){ %>
          <% if(w === 'gap'){ %>
            <span class="page-gap">…</span>
          <% } else { %>
            <a href="/blog<%= blogQs({page: w}) %>" class="page-btn <%= w === page ? 'active' : '' %>" <%= w === page ? 'aria-current="page"' : '' %>><%= w %></a>
          <% } %>
        <% }) %>
        <a href="/blog<%= blogQs({page: page + 1}) %>" class="page-btn <%= page >= totalPages ? 'disabled' : '' %>" aria-label="Next page" rel="next"><i class="ti ti-chevron-right"></i></a>
      </nav>
      <div class="pagination-note">Page <%= page %> of <%= totalPages %></div>
    <% } %>

  <% } %>
</div>

<section class="subscribe-sect">
  <div class="hero-grid"></div>
  <div class="subscribe-inner">
    <h2>Get the monthly intelligence brief</h2>
    <p>One email a month: what moved, what it means, and who to talk to. No noise.</p>
