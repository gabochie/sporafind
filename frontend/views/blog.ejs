  <meta property="og:site_name" content="Sporafind Intelligence">
  <meta property="og:locale" content="en_GB">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Blog — Sporafind Intelligence">
  <meta property="og:description" content="Expert analysis and intelligence on the Ghanaian diaspora.">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:image" content="https://sporafind.com/og-blog.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Sporafind Intelligence Blog — Ghanaian diaspora analysis">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Blog — Sporafind Intelligence">
  <meta name="twitter:description" content="Expert analysis and intelligence on the Ghanaian diaspora.">
  <meta name="twitter:image" content="https://sporafind.com/og-blog.png">
  <meta name="twitter:image:alt" content="Sporafind Intelligence Blog — Ghanaian diaspora analysis">
<link rel="alternate" type="application/rss+xml" title="Sporafind Blog RSS" href="/rss.xml">
