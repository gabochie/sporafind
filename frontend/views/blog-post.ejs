<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= post.metaTitle || post.title %></title>
<meta name="description" content="<%= post.metaDesc || post.excerpt %>">
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://sporafind.com/blog/<%= post.slug %>">

<!-- OG -->
<meta property="og:type" content="article">
<meta property="og:title" content="<%= post.metaTitle || post.title %>">
<meta property="og:description" content="<%= post.metaDesc || post.excerpt %>">
<meta property="og:url" content="https://sporafind.com/blog/<%= post.slug %>">
<meta property="og:image" content="https://sporafind.com/og-blog.png">
<meta property="article:published_time" content="<%= post.publishedAt %>">
<meta property="article:author" content="Sporafind Intelligence">
<meta property="article:section" content="<%= post.category %>">
<% (post.tags||[]).forEach(function(t){ %><meta property="article:tag" content="<%= t %>">
<% }) %>

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= post.metaTitle || post.title %>">
<meta name="twitter:description" content="<%= post.metaDesc || post.excerpt %>">

<!-- JSON-LD Article -->
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"<%= post.title.replace(/"/g,'\\"') %>","description":"<%= post.excerpt.replace(/"/g,'\\"') %>","author":{"@type":"Organization","name":"Sporafind"},"datePublished":"<%= post.publishedAt %>","dateModified":"<%= post.updatedAt %>","publisher":{"@type":"Organization","name":"Sporafind"},"mainEntityOfPage":{"@type":"WebPage","@id":"https://sporafind.com/blog/<%= post.slug %>"},"image":"https://sporafind.com/og-blog.png"}</script>

<!-- Breadcrumb JSON-LD -->
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Blog","item":"https://sporafind.com/blog"},{"@type":"ListItem","position":2,"name":"<%= post.category %>","item":"https://sporafind.com/blog?cat=<%= encodeURIComponent(post.category) %>"},{"@type":"ListItem","position":3,"name":"<%= post.title.replace(/"/g,'\\"') %>"}]}</script>

<link rel="alternate" type="application/rss+xml" title="Sporafind Blog RSS" href="/rss.xml">
<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/tabler-icons.min.css">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/components.css">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text-dark);line-height:1.6;-webkit-font-smoothing:antialiased}

/* Nav */
.nav{background:var(--navy);padding:0 32px;height:64px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
.nav-l{display:flex;align-items:center;gap:32px}
.nav-logo{display:flex;align-items:center;gap:8px;text-decoration:none;flex-shrink:0}
.nav-logomark{width:30px;height:30px;border-radius:8px;background:var(--green);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.nav-star{width:13px;height:13px;background:var(--gold);clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)}
.nav-wordmark{font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:700;letter-spacing:-0.3px;color:#fff}
.nav-wordmark span{color:var(--gold)}
.nav-links{display:flex;align-items:center;gap:4px;list-style:none}
.nav-links a{padding:8px 14px;border-radius:var(--radius-sm);color:rgba(255,255,255,0.55);font-size:14px;font-weight:500;text-decoration:none;transition:color .12s}
.nav-links a:hover{color:#fff}
.nav-r{display:flex;align-items:center;gap:12px}
.nav-btn{display:inline-flex;align-items:center;gap:6px;padding:9px 18px;border-radius:var(--radius-sm);font-size:14px;font-weight:600;text-decoration:none;transition:all .12s;font-family:'Inter',sans-serif}
.nav-btn-outline{color:rgba(255,255,255,0.7);border:0.5px solid rgba(255,255,255,0.2);background:transparent}
.nav-btn-outline:hover{color:#fff;border-color:var(--gold);background:rgba(212,160,23,0.08)}
.nav-btn-gold{background:var(--gold);color:#0A0E1A}
.nav-btn-gold:hover{background:var(--gold-dark)}
.nav-mobile-toggle{display:none;background:none;border:none;color:rgba(255,255,255,0.7);font-size:24px;cursor:pointer;padding:4px}

/* Breadcrumb */
.breadcrumb{max-width:740px;margin:0 auto;padding:20px 32px 0;font-size:13px;color:var(--text-muted)}
.breadcrumb a{color:var(--text-muted);text-decoration:none}
.breadcrumb a:hover{color:var(--green)}
.breadcrumb span{color:var(--text-mid)}

/* Article */
.article-wrap{max-width:740px;margin:0 auto;padding:32px 32px 60px}
.article-head{margin-bottom:32px;padding-bottom:24px;border-bottom:0.5px solid var(--cream2)}
.article-cat{display:inline-block;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--green);margin-bottom:12px}
.article-h1{font-family:'Space Grotesk',sans-serif;font-size:36px;font-weight:800;letter-spacing:-1px;line-height:1.15;margin-bottom:16px;color:var(--navy)}
.article-meta{display:flex;flex-wrap:wrap;gap:16px;font-size:13px;color:var(--text-muted)}
.article-meta span{display:flex;align-items:center;gap:5px}
.article-meta .views{color:var(--gold)}
.article-body{font-size:16px;line-height:1.8;color:var(--text-mid)}
.article-body h2{font-family:'Space Grotesk',sans-serif;font-size:24px;font-weight:700;color:var(--navy);margin:36px 0 12px;letter-spacing:-0.3px}
.article-body h3{font-family:'Space Grotesk',sans-serif;font-size:19px;font-weight:600;color:var(--navy);margin:28px 0 10px}
.article-body p{margin-bottom:18px}
.article-body p:last-child{margin-bottom:0}
.article-body a{color:var(--green);text-decoration:underline;text-underline-offset:2px}
.article-body a:hover{color:var(--gold);text-decoration-color:var(--gold)}
.article-body ul,.article-body ol{padding-left:24px;margin-bottom:18px}
.article-body li{margin-bottom:6px}
.article-body strong{color:var(--text-dark)}
.article-body blockquote{border-left:3px solid var(--gold);padding:16px 20px;margin:24px 0;background:var(--gold-light);border-radius:0 var(--radius-sm) var(--radius-sm) 0;font-style:italic;color:var(--text-dark)}
.article-body blockquote p{margin-bottom:0}

/* Tags */
.article-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:32px;padding-top:20px;border-top:0.5px solid var(--cream2)}
.article-tags a{padding:6px 14px;border-radius:15px;font-size:12px;font-weight:500;background:var(--cream2);color:var(--text-mid);text-decoration:none;transition:all .12s}
.article-tags a:hover{background:var(--green);color:#fff}

/* Related */
.related-sect{max-width:740px;margin:0 auto;padding:40px 32px 60px;border-top:0.5px solid var(--cream2)}
.related-hdr{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;color:var(--navy);margin-bottom:20px}
.related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px}
.related-card{background:var(--white);border:0.5px solid var(--cream2);border-radius:var(--radius-md);padding:20px;text-decoration:none;color:inherit;transition:box-shadow .2s}
.related-card:hover{box-shadow:0 4px 16px rgba(8,13,26,0.06)}
.related-card .rc-date{font-size:11px;color:var(--text-muted);margin-bottom:4px}
.related-card .rc-title{font-family:'Space Grotesk',sans-serif;font-size:15px;font-weight:600;line-height:1.3;color:var(--text-dark)}

/* Newsletter */
.newsletter-box{max-width:740px;margin:0 auto;padding:24px 32px 0}
.newsletter-inner{background:var(--navy);border-radius:var(--radius-md);padding:36px 40px;text-align:center}
.newsletter-inner h3{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;color:#fff;margin-bottom:6px}
.newsletter-inner p{color:rgba(255,255,255,0.5);font-size:14px;margin-bottom:16px}
.newsletter-inner form{display:flex;gap:8px;max-width:380px;margin:0 auto}
.newsletter-inner input{flex:1;padding:10px 14px;border-radius:var(--radius-sm);border:0.5px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.06);color:#fff;font-size:13px;font-family:'Inter',sans-serif;outline:none}
.newsletter-inner input::placeholder{color:var(--slate2)}
.newsletter-inner button{padding:10px 22px;background:var(--gold);color:#0A0E1A;font-weight:700;border:none;border-radius:var(--radius-sm);cursor:pointer;font-family:'Inter',sans-serif;font-size:13px;transition:background .12s}
.newsletter-inner button:hover{background:var(--gold-dark)}

/* Footer */
.footer{background:var(--navy);border-top:0.5px solid rgba(255,255,255,0.06);padding:48px 32px 32px;margin-top:48px}
.footer-inner{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px}
.footer-copy{font-size:13px;color:rgba(255,255,255,0.3)}
.footer-links{display:flex;gap:20px}
.footer-links a{color:rgba(255,255,255,0.4);text-decoration:none;font-size:13px;transition:color .12s}
.footer-links a:hover{color:var(--gold)}

@media(max-width: 900px){
  .nav{padding:0 16px}
  .nav-links{display:none}
  .nav-mobile-toggle{display:block}
  .article-wrap{padding:24px 16px 40px}
  .article-h1{font-size:26px}
  .related-sect{padding:32px 16px 40px}
  .related-grid{grid-template-columns:1fr}
  .newsletter-inner{padding:24px 20px}
  .newsletter-inner form{flex-direction:column}
  .footer{padding:32px 16px 24px}
}
</style>
</head>
<body>

<nav class="nav">
  <div class="nav-l">
    <a href="/" class="nav-logo"><div class="nav-logomark"><div class="nav-star"></div></div><span class="nav-wordmark">Spora<span>Find</span></span></a>
    <ul class="nav-links">
      <li><a href="/features">Features</a></li>
      <li><a href="/segments">Segments</a></li>
      <li><a href="/pricing">Pricing</a></li>
      <li><a href="/blog" style="color:#fff">Blog</a></li>
      <li><a href="/about">About</a></li>
    </ul>
  </div>
  <div class="nav-r">
    <a href="/workspace" class="nav-btn nav-btn-outline"><i class="ti ti-user"></i> Sign in</a>
    <a href="/pricing" class="nav-btn nav-btn-gold">Get early access</a>
    <button class="nav-mobile-toggle" onclick="var m=this.parentElement.parentElement.querySelector('.nav-links');m.style.display=m.style.display==='flex'?'none':'flex';m.style.flexDirection='column';m.style.position='absolute';m.style.top='64px';m.style.left='0';m.style.right='0';m.style.background='var(--navy)';m.style.padding='16px';m.style.gap='4px'"><i class="ti ti-menu-2"></i></button>
  </div>
</nav>

<div class="breadcrumb">
  <a href="/blog">Blog</a> / <a href="/blog?cat=<%= encodeURIComponent(post.category) %>"><%= post.category %></a> / <span><%= post.title %></span>
</div>

<article class="article-wrap">
  <div class="article-head">
    <div class="article-cat"><%= post.category %></div>
    <h1 class="article-h1"><%= post.title %></h1>
    <div class="article-meta">
      <span><i class="ti ti-calendar"></i> <%= new Date(post.publishedAt).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'}) %></span>
      <span><i class="ti ti-clock"></i> <%= Math.ceil(post.body.split(' ').length / 200) %> min read</span>
      <span><i class="ti ti-user"></i> Sporafind Intelligence</span>
      <span class="views"><i class="ti ti-eye"></i> <%= post.views %> views</span>
    </div>
  </div>
  <div class="article-body">
    <%- post.body %>
  </div>
  <div class="article-tags">
    <% (post.tags||[]).forEach(function(t){ %>
      <a href="/blog?tag=<%= encodeURIComponent(t) %>">#<%= t %></a>
    <% }) %>
  </div>
</article>

<% if(related.length > 0) { %>
<section class="related-sect">
  <h2 class="related-hdr">Related articles</h2>
  <div class="related-grid">
    <% related.forEach(function(r){ %>
      <a href="/blog/<%= r.slug %>" class="related-card">
        <div class="rc-date"><%= new Date(r.publishedAt).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) %></div>
        <div class="rc-title"><%= r.title %></div>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

<div class="newsletter-box">
  <div class="newsletter-inner">
    <h3>Stay informed</h3>
    <p>Get diaspora intelligence directly in your inbox.</p>
    <form onsubmit="event.preventDefault();alert('Subscribed! (demo)')">
      <input type="email" placeholder="you@organisation.com" required>
      <button type="submit">Subscribe</button>
    </form>
  </div>
</div>

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-copy">&copy; <%= new Date().getFullYear() %> Sporafind. All rights reserved.</div>
    <div class="footer-links">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/sources">Sources</a>
      <a href="/contact">Contact</a>
    </div>
  </div>
</footer>

<script src="/js/session.js"></script>
<script>
// Track page view
fetch('/api/analytics/pageview', {
  method:'POST',
  headers:{'Content-Type':'application/json'},
  body:JSON.stringify({slug:'<%= post.slug %>'})
}).catch(function(){});
</script>
</body>
</html>
