      <a class="share-btn" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(shareUrl) %>" target="_blank" rel="noopener noreferrer"><i class="ti ti-brand-linkedin"></i> LinkedIn</a>
      <a class="share-btn" href="https://wa.me/?text=<%= encodeURIComponent(shareTitle + ' ' + shareUrl) %>" target="_blank" rel="noopener noreferrer"><i class="ti ti-brand-whatsapp"></i> WhatsApp</a>
      <button type="button" class="share-btn" id="copyLink" data-url="<%= shareUrl %>"><i class="ti ti-link"></i> <span>Copy link</span></button>
    </div>

    <div class="author-box">
      <div class="author-mark"><div class="nav-star"></div></div>
      <div>
        <b>Gabochie Intelligence</b>
        <p>The research desk behind Sporafind. We turn diaspora datasets into decision-ready briefs for operators, investors and institutions.</p>
        <a href="/about.html">More about the team →</a>
      </div>
    </div>

    <% if(prevPost || nextPost){ %>
    <nav class="post-nav" aria-label="Article navigation">
      <% if(prevPost){ %>
        <a href="/blog/<%= prevPost.slug %>" rel="prev">
          <span class="dir"><i class="ti ti-arrow-left"></i> Previous</span>
          <span class="t"><%= prevPost.title %></span>
        </a>
      <% } %>
      <% if(nextPost){ %>
        <a href="/blog/<%= nextPost.slug %>" class="next" rel="next">
          <span class="dir">Next <i class="ti ti-arrow-right"></i></span>
          <span class="t"><%= nextPost.title %></span>
        </a>
      <% } %>
    </nav>
    <% } %>
  </main>

  <aside class="toc" aria-label="On this page">
