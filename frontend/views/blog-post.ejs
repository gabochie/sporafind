      <p>Search verified diaspora profiles and organisations in the workspace.</p>
      <a href="/workspace.html">Open workspace <i class="ti ti-arrow-right"></i></a>
    </div>
  </aside>
</div>

<% if(related.length > 0) { %>
<section class="related-sect">
  <h2 class="related-hdr">Keep reading</h2>
  <div class="related-grid">
    <% related.forEach(function(r){ %>
      <a href="/blog/<%= r.slug %>" class="related-card">
