<script>
// Reading progress + table of contents (progressive enhancement)
(function(){
  var fill = document.getElementById('readFill');
  var body = document.querySelector('.article-body');
  if(fill){
    var tick = function(){
      var h = document.documentElement.scrollHeight - window.innerHeight;
      fill.style.width = (h > 0 ? Math.min(100, Math.max(0, (window.scrollY / h) * 100)) : 0) + '%';
    };
    tick();
    window.addEventListener('scroll', tick, {passive:true});
    window.addEventListener('resize', tick);
  }

  var copy = document.getElementById('copyLink');
  if(copy){
    copy.addEventListener('click', function(){
      var label = copy.querySelector('span');
      var done = function(text, icon){
        label.textContent = text;
        copy.querySelector('i').className = icon;
        setTimeout(function(){ label.textContent = 'Copy link'; copy.querySelector('i').className = 'ti ti-link'; }, 2000);
      };
      if(navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(copy.getAttribute('data-url'))
          .then(function(){ done('Copied', 'ti ti-check'); })
          .catch(function(){ done('Press Ctrl+C', 'ti ti-alert-circle'); });
      } else { done('Press Ctrl+C', 'ti ti-alert-circle'); }
    });
  }

  var list = document.getElementById('tocList');
  if(!list || !body) return;
  var heads = [].slice.call(body.querySelectorAll('h2'));
  if(heads.length < 2){ document.querySelector('.toc-title').textContent = 'In this brief'; return; }

  var links = heads.map(function(h, i){
    if(!h.id) h.id = 's' + (i + 1) + '-' + h.textContent.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,40);
    var li = document.createElement('li');
    var a = document.createElement('a');
    a.href = '#' + h.id;
    a.textContent = h.textContent;
    li.appendChild(a);
    list.appendChild(li);
    return a;
  });

  var setActive = function(idx){ links.forEach(function(a, i){ a.classList.toggle('active', i === idx); }); };
  if('IntersectionObserver' in window){
    var visible = {};
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ visible[e.target.id] = e.isIntersecting ? e.intersectionRatio : 0; });
      var best = -1, bestRatio = 0;
      heads.forEach(function(h, i){ if((visible[h.id] || 0) > bestRatio){ bestRatio = visible[h.id]; best = i; } });
      if(best >= 0) setActive(best);
    }, {rootMargin:'-96px 0px -60% 0px', threshold:[0, 0.25, 0.5, 1]});
    heads.forEach(function(h){ io.observe(h); });
  }
})();
</script>
