<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<!--CHROME:HEAD:START-->
<!-- SPORAFIND PWA HEAD — single source of truth.
     Managed by scripts/build-chrome.js. Push reads its VAPID key from
     GET /api/push/vapid-key at subscribe time (503 until configured). -->
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#080D1A">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Sporafind">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<script src="/js/pwa.js" defer></script>
<!--CHROME:HEAD:END-->
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= post.metaTitle || post.title %></title>
<meta name="description" content="<%= post.metaDesc || post.excerpt %>">
<meta name="robots" content="index, follow">
<meta name="author" content="Gabochie Intelligence">
  <meta property="og:site_name" content="Sporafind Intelligence">
  <meta property="og:locale" content="en_GB">

<!-- OG -->
<meta property="og:type" content="article">
<meta property="og:title" content="<%= post.metaTitle || post.title %>">
<meta property="og:description" content="<%= post.metaDesc || post.excerpt %>">
<meta property="og:url" content="https://sporafind.com/blog/<%= post.slug %>">
  <meta property="og:image" content="https://sporafind.com/img/og/<%= post.slug %>.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="<%= (post.imageAlt || post.title).replace(/"/g, '&quot;') %>">
  <meta property="article:published_time" content="<%= post.publishedAt %>">
  <meta property="article:modified_time" content="<%= post.updatedAt || post.publishedAt %>">
  <meta property="article:section" content="<%= post.category %>">
<meta property="article:published_time" content="<%= post.publishedAt %>">
<meta property="article:modified_time" content="<%= post.updatedAt || post.publishedAt %>">
<meta property="article:author" content="Sporafind Intelligence">
<meta property="article:section" content="<%= post.category %>">
<% (post.tags||[]).forEach(function(t){ %><meta property="article:tag" content="<%= t %>">
<% }) %>

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= post.metaTitle || post.title %>">
  <meta name="twitter:image" content="https://sporafind.com/img/og/<%= post.slug %>.jpg">
  <meta name="twitter:image:alt" content="<%= (post.imageAlt || post.title).replace(/"/g, '&quot;') %>">

<!-- JSON-LD Article -->
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"<%= post.title.replace(/"/g,'\\"') %>","description":"<%= post.excerpt.replace(/"/g,'\\"') %>","author":{"@type":"Organization","name":"Gabochie Intelligence","url":"https://sporafind.com/about"},"datePublished":"<%= post.publishedAt %>","dateModified":"<%= post.updatedAt || post.publishedAt %>","publisher":{"@type":"Organization","name":"Sporafind"},"mainEntityOfPage":{"@type":"WebPage","@id":"https://sporafind.com/blog/<%= post.slug %>"},"image":["https://sporafind.com/img/og/<%= post.slug %>.jpg","https://sporafind.com/og-blog.png"],"wordCount":<%= Math.round(post.readMinutes * 220) %>,"inLanguage":"en","articleSection":"<%= post.category %>"}</script>

<!-- Breadcrumb JSON-LD -->
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Blog","item":"https://sporafind.com/blog"},{"@type":"ListItem","position":2,"name":"<%= post.category %>","item":"https://sporafind.com/blog?cat=<%= encodeURIComponent(post.category) %>"},{"@type":"ListItem","position":3,"name":"<%= post.title.replace(/"/g,'\\"') %>"}]}</script>

<link rel="alternate" type="application/rss+xml" title="Sporafind Blog RSS" href="/rss.xml">
<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/tabler-icons.min.css">
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/components.css">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text-dark);line-height:1.6;-webkit-font-smoothing:antialiased}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px;border-radius:4px}

/* Nav + footer come from shared chrome: /css/components.css */

/* Reading progress */
.read-bar{position:fixed;top:0;left:0;height:3px;width:100%;z-index:200;background:transparent;pointer-events:none}
.read-bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--gold),#E8C25A);transition:width .1s linear}

/* ---------- Article header ---------- */
.article-hero{background:var(--navy);position:relative;overflow:hidden;padding:0 48px 56px}
.article-hero::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.03) 1px,transparent 1px);background-size:60px 60px;pointer-events:none}
.article-hero::after{content:'';position:absolute;top:-60%;left:50%;transform:translateX(-50%);width:820px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(212,160,23,0.10) 0%,transparent 62%);pointer-events:none}
.article-hero-inner{max-width:880px;margin:0 auto;position:relative;z-index:2;padding-top:32px}
.article-hero-photo{padding:0}
.article-hero-photo .article-hero-inner{padding:56px 48px 64px}
.article-hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;
  filter:saturate(0.92) contrast(1.04) brightness(0.55)}
.article-hero-photo::before,.article-hero-photo::after{display:none}
.article-hero-credit{position:absolute;right:48px;bottom:24px;z-index:2;font-size:10px;line-height:1.3;
  color:rgba(255,255,255,0.72);background:rgba(8,13,26,0.5);padding:3px 8px;border-radius:8px;
  backdrop-filter:blur(6px);max-width:78%;text-align:right}
.article-hero-credit a{color:rgba(255,255,255,0.86)}
.crumb{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:13px;color:rgba(255,255,255,0.4);margin-bottom:28px}
.crumb a{color:rgba(255,255,255,0.55);text-decoration:none;transition:color .14s}
.crumb a:hover{color:var(--gold)}
.crumb .sep{opacity:0.4}
.crumb .now{color:rgba(255,255,255,0.75);max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hero-cat{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--gold);background:rgba(212,160,23,0.12);border:0.5px solid rgba(212,160,23,0.28);padding:6px 14px;border-radius:16px;margin-bottom:20px}
.article-h1{font-family:'Space Grotesk',sans-serif;font-size:42px;font-weight:800;line-height:1.14;letter-spacing:-1.4px;color:#fff;margin-bottom:18px}
.article-dek{font-size:18px;line-height:1.65;color:rgba(255,255,255,0.6);max-width:720px;margin-bottom:28px}
.article-byline{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding-top:24px;border-top:0.5px solid rgba(255,255,255,0.08)}
.author-mark{width:40px;height:40px;border-radius:10px;background:var(--green);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.author-mark .nav-star{width:16px;height:16px}
.byline-text{display:flex;flex-direction:column;gap:1px;margin-right:auto}
.byline-text b{font-size:14px;font-weight:600;color:#fff}
.byline-text span{font-size:12px;color:rgba(255,255,255,0.4)}
.byline-meta{display:flex;align-items:center;gap:16px;flex-wrap:wrap;font-size:13px;color:rgba(255,255,255,0.45)}
.byline-meta span{display:inline-flex;align-items:center;gap:6px}
.byline-meta .views{color:var(--gold)}

/* ---------- Layout ---------- */
.article-layout{max-width:1200px;margin:0 auto;padding:56px 48px 96px;display:grid;grid-template-columns:minmax(0,1fr) 232px;gap:56px;align-items:start}
.article-main{min-width:0}
.article-body{font-size:17px;line-height:1.78;color:var(--text-mid);max-width:68ch}
.article-body>*+*{margin-top:20px}
.article-body h2{font-family:'Space Grotesk',sans-serif;font-size:26px;font-weight:700;color:var(--navy);letter-spacing:-0.6px;line-height:1.3;margin-top:48px;padding-top:24px;border-top:0.5px solid var(--cream2);scroll-margin-top:96px}
.article-body h2:first-child{margin-top:0;padding-top:0;border-top:none}
.article-body h3{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:600;color:var(--navy);margin-top:34px;line-height:1.4;letter-spacing:-0.3px;scroll-margin-top:96px}
.article-body h4{font-family:'Space Grotesk',sans-serif;font-size:17px;font-weight:600;color:var(--navy);margin-top:28px}
.article-body strong{color:var(--text-dark);font-weight:600}
.article-body a{color:var(--green);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px;transition:color .14s}
.article-body a:hover{color:var(--gold-dark);text-decoration-color:var(--gold)}
.article-body ul,.article-body ol{padding-left:22px}
.article-body li{margin-bottom:10px;padding-left:4px}
.article-body li::marker{color:var(--green)}
.article-body ul li::marker{color:var(--green)}
.article-body blockquote{border-left:3px solid var(--gold);padding:18px 22px;margin:28px 0;background:var(--gold-light);border-radius:0 var(--radius) var(--radius) 0}
.article-body blockquote p{margin:0;color:var(--text-dark)}
.article-body hr{border:none;border-top:0.5px solid var(--cream2);margin:36px 0}
.article-body img{max-width:100%;height:auto;border-radius:var(--radius)}
.article-body code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:0.88em;background:var(--bg);border:0.5px solid var(--cream2);border-radius:4px;padding:2px 6px}
.article-body pre{background:var(--navy);color:#E6EAF2;border-radius:var(--radius);padding:18px 20px;overflow-x:auto;font-size:13px;line-height:1.6}
.article-body pre code{background:none;border:none;padding:0;color:inherit}
.article-body table{width:100%;border-collapse:collapse;font-size:14px;display:block;overflow-x:auto}
.article-body th,.article-body td{border:0.5px solid var(--cream2);padding:10px 12px;text-align:left}
.article-body th{background:var(--cream);color:var(--navy);font-weight:600}
.article-body .tldr{background:var(--green-light);border-left:3px solid var(--green);border-radius:0 var(--radius) var(--radius) 0;padding:18px 22px;font-size:16px;line-height:1.7;color:var(--text-dark)}
.article-body .tldr strong{color:var(--green-dark)}

/* ---------- Tags, share, author ---------- */
.article-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:44px;padding-top:24px;border-top:0.5px solid var(--cream2)}
.article-tags a{padding:7px 15px;border-radius:16px;font-size:12px;font-weight:500;background:var(--white);border:0.5px solid var(--cream2);color:var(--text-mid);text-decoration:none;transition:all .14s}
.article-tags a:hover{background:var(--green);border-color:var(--green);color:#fff}

.share-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:28px}
.share-row .share-label{font-size:12px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--text-muted);margin-right:4px}
.share-btn{display:inline-flex;align-items:center;gap:7px;padding:8px 14px;border-radius:20px;border:0.5px solid var(--cream2);background:var(--white);color:var(--text-mid);font-size:13px;font-weight:500;text-decoration:none;transition:all .14s;min-height:36px}
.share-btn:hover{border-color:var(--navy);color:var(--navy)}
.share-btn i{font-size:15px}

.author-box{display:flex;gap:16px;align-items:flex-start;margin-top:44px;padding:24px;background:var(--white);border:0.5px solid var(--cream2);border-radius:var(--radius-lg)}
.author-box .author-mark{width:48px;height:48px}
.author-box .author-mark .nav-star{width:19px;height:19px}
.author-box b{display:block;font-family:'Space Grotesk',sans-serif;font-size:16px;color:var(--navy);margin-bottom:4px}
.author-box p{font-size:14px;line-height:1.65;color:var(--text-mid);margin-bottom:12px}
.author-box a{font-size:13px;font-weight:600;color:var(--green);text-decoration:none}
.author-box a:hover{text-decoration:underline}

/* ---------- Prev / next ---------- */
.post-nav{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:32px}
.post-nav a{display:flex;flex-direction:column;gap:8px;padding:20px 22px;background:var(--white);border:0.5px solid var(--cream2);border-radius:var(--radius-md);text-decoration:none;transition:all .16s}
.post-nav a:hover{border-color:var(--gold);box-shadow:var(--shadow)}
.post-nav .dir{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:var(--text-muted)}
.post-nav .t{font-family:'Space Grotesk',sans-serif;font-size:15px;font-weight:600;line-height:1.4;color:var(--text-dark);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.post-nav .next{text-align:right;align-items:flex-end}
.post-nav .next .dir i{order:2}

/* ---------- TOC ---------- */
.toc{position:sticky;top:96px}
.toc-title{font-size:11px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:var(--text-muted);margin-bottom:14px}
.toc-list{border-left:0.5px solid var(--cream2);padding-left:0;margin:0;list-style:none}
.toc-list li a{display:block;padding:7px 0 7px 16px;font-size:13px;line-height:1.45;color:var(--text-muted);text-decoration:none;border-left:2px solid transparent;margin-left:-0.5px;transition:all .14s}
.toc-list li a:hover{color:var(--text-dark)}
.toc-list li a.active{color:var(--green);border-left-color:var(--green);font-weight:600}
.toc-cta{margin-top:24px;padding:20px;background:var(--navy);border-radius:var(--radius-md)}
.toc-cta h4{font-family:'Space Grotesk',sans-serif;font-size:15px;color:#fff;margin-bottom:6px}
.toc-cta p{font-size:12.5px;color:rgba(255,255,255,0.45);line-height:1.55;margin-bottom:14px}
.toc-cta a{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:var(--radius-sm);background:var(--gold);color:#0A0E1A;font-size:13px;font-weight:700;text-decoration:none;transition:background .14s}
.toc-cta a:hover{background:var(--gold-dark)}

/* ---------- Related ---------- */
.related-sect{max-width:1200px;margin:0 auto;padding:0 48px 72px}
.related-hdr{font-family:'Space Grotesk',sans-serif;font-size:24px;font-weight:700;color:var(--navy);margin-bottom:24px;letter-spacing:-0.5px}
.related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.related-card{display:flex;flex-direction:column;background:var(--white);border:0.5px solid var(--cream2);border-radius:var(--radius-md);overflow:hidden;text-decoration:none;transition:all .2s}
.related-card:hover{box-shadow:var(--shadow-md);transform:translateY(-2px)}
.related-card .cover{height:110px}
.related-card .cover .cover-icon{font-size:52px}
.related-body{padding:16px 18px 18px;display:flex;flex-direction:column;flex:1}
.rc-meta{font-size:11.5px;color:var(--text-muted);margin-bottom:8px}
.rc-title{font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:600;line-height:1.35;color:var(--text-dark);letter-spacing:-0.2px}

/* ---------- Newsletter ---------- */
.newsletter-box{max-width:1200px;margin:0 auto;padding:0 48px 88px}
.newsletter-inner{background:var(--navy);border-radius:var(--radius-lg);padding:44px 48px;text-align:center;position:relative;overflow:hidden}
.newsletter-inner::after{content:'';position:absolute;top:-50%;left:50%;transform:translateX(-50%);width:640px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(212,160,23,0.10) 0%,transparent 65%);pointer-events:none}
.newsletter-inner>*{position:relative;z-index:2}
.newsletter-inner h3{font-family:'Space Grotesk',sans-serif;font-size:24px;font-weight:700;color:#fff;margin-bottom:8px}
.newsletter-inner p{color:rgba(255,255,255,0.5);font-size:14.5px;margin-bottom:20px}
.subscribe-form{display:flex;gap:10px;max-width:400px;margin:0 auto}
.subscribe-form input{flex:1;min-width:0;padding:12px 16px;border-radius:var(--radius-sm);border:0.5px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.06);color:#fff;font-size:14px;font-family:'Inter',sans-serif;outline:none}
.subscribe-form input::placeholder{color:var(--slate2)}
.subscribe-form input:focus{border-color:var(--gold)}
.subscribe-form button{padding:12px 24px;background:var(--gold);color:#0A0E1A;font-weight:700;border:none;border-radius:var(--radius-sm);cursor:pointer;font-family:'Inter',sans-serif;font-size:14px;white-space:nowrap;transition:background .14s}
.subscribe-form button:hover{background:var(--gold-dark)}

@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{transition:none!important;animation:none!important;scroll-behavior:auto!important}
}

@media(max-width:1200px){
  .article-layout{grid-template-columns:minmax(0,1fr);gap:40px}
  .toc{display:none}
  .article-h1{font-size:36px}
}
@media(max-width:900px){
  .article-hero{padding:0 20px 40px}
  .article-hero-inner{padding-top:20px}
  .article-h1{font-size:28px;letter-spacing:-0.8px}
  .article-dek{font-size:16px}
  .article-layout{padding:32px 20px 64px}
  .article-body{font-size:16.5px}
  .article-body h2{font-size:22px;margin-top:36px;padding-top:20px}
  .article-body h3{font-size:18px}
  .byline-meta{width:100%}
  .related-sect{padding:0 20px 48px}
  .related-grid{grid-template-columns:1fr}
  .newsletter-box{padding:0 20px 56px}
  .newsletter-inner{padding:28px 22px}
  .newsletter-inner h3{font-size:20px}
  .subscribe-form{flex-direction:column}
  .post-nav{grid-template-columns:1fr}
  .post-nav .next{text-align:left;align-items:flex-start}
  .post-nav .next .dir i{order:0}
  .crumb .now{display:none}
}
</style>
</head>
<body>

<!--CHROME:HEADER:START-->
<!-- SPORAFIND SHARED HEADER — single source of truth.
     Managed by scripts/build-chrome.js. DO NOT edit nav copies in pages;
     edit this file then run: npm run build:chrome -->
<nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <div class="nav-logomark"><div class="nav-star"></div></div>
      <div class="nav-wordmark">Spora<span>Find</span></div>
    </a>
    <div class="nav-links">
      <a href="/features.html" data-nav="features">Features</a>
      <a href="/segments.html" data-nav="segments">Segments</a>
      <a href="/pricing.html" data-nav="pricing">Pricing</a>
      <a href="/api-docs.html" data-nav="api-docs">API docs</a>
      <a href="/changelog.html" data-nav="changelog">Changelog</a>
    </div>
    <div class="nav-cta">
      <a href="/workspace.html" class="btn-ghost-nav">Sign in</a>
      <a href="/pricing.html" class="btn-primary-nav">Get early access →</a>
    </div>
    <button class="nav-mobile-toggle" id="navToggle" aria-label="Toggle menu"><i class="ti ti-menu-2"></i></button>
  </div>
</nav>
<script>
(function(){if(window.__sfNavBound)return;window.__sfNavBound=true;
document.addEventListener('click',function(e){
  var b=e.target.closest?e.target.closest('#navToggle'):null;if(!b)return;
  var l=document.querySelector('.nav-links');if(!l)return;
  l.classList.toggle('open');
  var i=b.querySelector('i');if(i)i.className=l.classList.contains('open')?'ti ti-x':'ti ti-menu-2';
});})();
</script>
<!--CHROME:HEADER:END-->

<%
  var compact = new Intl.NumberFormat('en',{notation:'compact',maximumFractionDigits:1});
  var shareUrl = 'https://sporafind.com/blog/' + post.slug;
  var shareTitle = post.title;
%>

<div class="read-bar" aria-hidden="true"><i id="readFill"></i></div>

<header class="article-hero<%= post.featureImage ? ' article-hero-photo' : '' %>">
  <div class="article-hero-inner">
    <% if (post.featureImage) { %>
      <img class="article-hero-img" src="<%= post.featureImage %>" alt="<%= post.featureImageAlt %>"
           width="1200" height="630" loading="eager" decoding="async" fetchpriority="high">
      <span class="article-hero-credit">Photo: <%= post.featureImageCredit %></span>
    <% } %>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/blog">Blog</a><span class="sep">/</span>
      <a href="/blog?cat=<%= encodeURIComponent(post.category) %>"><%= post.category %></a><span class="sep">/</span>
      <span class="now"><%= post.title %></span>
    </nav>
    <span class="hero-cat"><i class="ti <%= post.coverIcon %>"></i> <%= post.category %></span>
    <h1 class="article-h1"><%= post.title %></h1>
    <p class="article-dek"><%= post.excerpt %></p>
    <div class="article-byline">
      <div class="author-mark"><div class="nav-star"></div></div>
      <div class="byline-text">
        <b>Gabochie Intelligence</b>
        <span>Research desk, Accra</span>
      </div>
      <div class="byline-meta">
        <span><i class="ti ti-calendar"></i> <time datetime="<%= post.publishedAt %>"><%= post.dateLabel %></time></span>
        <span><i class="ti ti-clock"></i> <%= post.readMinutes %> min read</span>
        <span class="views"><i class="ti ti-eye"></i> <%= compact.format(post.views) %> views</span>
      </div>
    </div>
  </div>
</header>

<div class="article-layout">
