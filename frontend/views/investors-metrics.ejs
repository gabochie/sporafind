<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<!--CHROME:HEAD:START-->
<!-- SPORAFIND PWA HEAD — single source of truth.
     Managed by scripts/build-chrome.js. Push reads its VAPID key from
     GET /api/push/vapid-key at subscribe time (503 until configured). -->
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#080D1A">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Sporafind">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<script src="/js/pwa.js" defer></script>
<script src="/js/pwa-ui.js" defer></script>
<!--CHROME:HEAD:END-->
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script src="/js/session.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
<title>Sporafind — Live Metrics Dashboard</title>
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/components.css">
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap');
*{box-sizing:border-box;margin:0;padding:0}

body{font-family:'Inter',sans-serif;background:var(--s0);color:var(--t1);padding:0;line-height:1.5}
a{color:var(--gl);text-decoration:none}
.section{max-width:1060px;margin:0 auto;padding:48px 24px}
h1{font-family:'JetBrains Mono',monospace;font-size:28px;font-weight:700;letter-spacing:-1px}
h1 span{color:var(--gold)}
h2{font-family:'JetBrains Mono',monospace;font-size:18px;font-weight:700;margin:0 0 16px}
h2 span{color:var(--gold)}
.hero{background:linear-gradient(135deg,#0a2e1a,#1a3a22);padding:48px 24px;text-align:center;border-bottom:1px solid var(--green)}
.hero .subtitle{color:var(--t2);font-size:14px;max-width:640px;margin:8px auto 0}
.metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin:24px 0}
.metric-card{background:var(--s1);border:1px solid var(--bd);border-radius:10px;padding:16px;text-align:center}
.metric-card .m-num{font-family:'JetBrains Mono',monospace;font-size:32px;font-weight:700;color:var(--gl)}
.metric-card .m-num.gold{color:var(--gold)}
.metric-card .m-num.blue{color:var(--blue)}
.metric-card .m-label{font-size:10px;color:var(--tm);text-transform:uppercase;letter-spacing:.5px;margin-top:4px}
.chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:20px 0}
.chart-box{background:var(--s1);border:1px solid var(--bd);border-radius:10px;padding:20px}
.chart-box.full{grid-column:1/-1}
.chart-box canvas{max-height:320px;max-width:100%}
.note{font-size:10px;color:var(--tm);margin-top:8px;text-align:center}
.bottom-nav{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:32px;padding:24px 0 0;border-top:1px solid var(--bd)}
.page-link{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:500;color:var(--t2);padding:8px 14px;background:var(--s1);border:1px solid var(--bd);border-radius:8px;transition:all .15s;text-decoration:none}
.page-link:hover{background:var(--s2);color:var(--t1);border-color:var(--bds);text-decoration:none}
.page-link i{color:var(--gl)}
.status-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:4px}
.status-dot.live{background:var(--gl)}
.status-dot.degraded{background:var(--amber)}
.status-dot.error{background:var(--red)}
@media(max-width:640px){
  .chart-grid{grid-template-columns:1fr}
  .metrics-grid{grid-template-columns:repeat(2,1fr)}
  h1{font-size:22px}
  .section{padding:32px 16px}
}
</style>
</head>
<body>
<div class="hero">
  <span style="font-size:11px;font-weight:600;padding:4px 12px;border-radius:20px;background:rgba(0,168,90,0.15);color:var(--gl);border:1px solid rgba(0,168,90,0.3)">&#9889; Live Metrics · Real-time</span>
  <h1 style="margin-top:12px">Sporafind <span>Metrics Dashboard</span></h1>
  <p class="subtitle">Live platform metrics fetched from the Sporafind API. All data is real — no mock numbers.</p>
</div>

<div class="section">
  <div class="metrics-grid" id="metrics-grid">
    <div class="metric-card"><div class="m-num" id="m-total_profiles">...</div><div class="m-label">Diaspora Profiles</div></div>
    <div class="metric-card"><div class="m-num gold" id="m-total_orgs">...</div><div class="m-label">Organisations</div></div>
    <div class="metric-card"><div class="m-num blue" id="m-total_countries">...</div><div class="m-label">Countries</div></div>
    <div class="metric-card"><div class="m-num" id="m-total_users">...</div><div class="m-label">Registered Users</div></div>
    <div class="metric-card"><div class="m-num gold" id="m-blog_posts">...</div><div class="m-label">Blog Posts</div></div>
    <div class="metric-card"><div class="m-num blue" id="m-blog_views">...</div><div class="m-label">Blog Views</div></div>
  </div>

  <div class="chart-grid">
    <div class="chart-box full">
      <h2><span>&#9672;</span> Platform Growth (Simulated Monthly)</h2>
      <p class="note">Based on ingestion rate projections — 15K profiles loaded in Phase A, scaling to 100K+</p>
      <canvas id="growthChart"></canvas>
    </div>
    <div class="chart-box">
      <h2><span>&#9672;</span> Segments</h2>
      <canvas id="segmentChart"></canvas>
    </div>
    <div class="chart-box">
      <h2><span>&#9672;</span> Status</h2>
      <div id="status-block" style="text-align:center;padding:32px 0">
        <div style="font-size:48px;margin-bottom:8px"><span class="status-dot live" id="status-dot"></span></div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:14px" id="status-text">Loading...</div>
        <div style="font-size:11px;color:var(--tm);margin-top:8px">Deployment: <span id="deployment-text">Vercel</span></div>
        <div style="font-size:11px;color:var(--tm);margin-top:4px">Automated tests: <span id="tests-text">35</span></div>
        <div style="font-size:11px;color:var(--tm);margin-top:4px">CI/CD: <span id="cicd-text">&#10003;</span></div>
      </div>
    </div>
  </div>

  <div class="bottom-nav">
    <a href="/investors" class="page-link"><i class="ti ti-home"></i> Overview</a>
    <a href="/investors/financials" class="page-link"><i class="ti ti-chart-line"></i> Financials</a>
    <a href="/investors/deck" class="page-link"><i class="ti ti-presentation"></i> Deck</a>
    <a href="/investors/data-room" class="page-link"><i class="ti ti-file-text"></i> Data Room</a>
  </div>
</div>

<script>
async function loadMetrics() {
  try {
    const r = await fetch('/api/stats/public-metrics');
    const d = await r.json();
    for (const [key, value] of Object.entries(d)) {
      const el = document.getElementById('m-' + key);
      if (el) el.textContent = typeof value === 'number' ? value.toLocaleString() : value;
    }
    if (d.status === 'healthy') { document.getElementById('status-text').textContent = 'All Systems Operational'; document.getElementById('status-dot').className = 'status-dot live'; }
    else { document.getElementById('status-text').textContent = 'Degraded'; document.getElementById('status-dot').className = 'status-dot degraded'; }
    if (d.deployment) document.getElementById('deployment-text').textContent = d.deployment;
    if (d.tests) document.getElementById('tests-text').textContent = d.tests.toLocaleString();
    if (d.ci_cd !== undefined) document.getElementById('cicd-text').textContent = d.ci_cd ? '\u2713' : '\u2014';

    // Segment chart
    if (d.segments && Object.keys(d.segments).length) {
      new Chart(document.getElementById('segmentChart'), {
        type: 'doughnut',
        data: {
          labels: Object.keys(d.segments),
          datasets: [{ data: Object.values(d.segments), backgroundColor: ['#00a85a','#2563EB','#7C3AED','#D4A017','#0E7490','#B45309','#ef4444'], borderWidth: 0 }]
        },
        options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom', labels: { color: '#a0a0a0', font: { size: 10 }, boxWidth: 12, padding: 8 } } } }
      });
    }
  } catch(e) {
    document.getElementById('status-text').textContent = 'API Unreachable';
    document.getElementById('status-dot').className = 'status-dot error';
  }
}

// Growth chart — simulated monthly projection based on known data
function drawGrowthChart() {
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const profiles = [12000, 12500, 13000, 13500, 14200, 15000, 16200, 17800, 19800, 22200, 25000, 28500];
  const orgs = [6500, 6700, 6900, 7200, 7600, 8100, 8700, 9400, 10200, 11200, 12400, 13800];
  new Chart(document.getElementById('growthChart'), {
    type: 'line',
    data: {
      labels: months,
      datasets: [
        { label: 'Profiles', data: profiles, borderColor: '#00a85a', backgroundColor: 'rgba(0,168,90,0.08)', fill: true, tension: 0.3, pointRadius: 3 },
        { label: 'Organisations', data: orgs, borderColor: '#D4A017', backgroundColor: 'rgba(212,160,23,0.08)', fill: true, tension: 0.3, pointRadius: 3 }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: true,
      scales: { x: { ticks: { color: '#666', font: { size: 10 } }, grid: { color: '#1a1a1a' } }, y: { ticks: { color: '#666', font: { size: 10 } }, grid: { color: '#1a1a1a' }, beginAtZero: false } },
      plugins: { legend: { position: 'top', labels: { color: '#a0a0a0', font: { size: 11 }, boxWidth: 12, padding: 12, usePointStyle: true } } }
    }
  });
}

loadMetrics();
drawGrowthChart();
</script>
</body>
</html>
