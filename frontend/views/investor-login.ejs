  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <div class="nav-logomark"><div class="nav-star"></div></div>
      <div class="nav-wordmark">Spora<span>Find</span></div>
    </a>
    <div class="nav-links">
      <a href="/features.html" data-nav="features">Features</a>
      <a href="/segments.html" data-nav="segments">Segments</a>
      <a href="/pricing.html" data-nav="pricing">Pricing</a>
      <a href="/api-docs.html" data-nav="api-docs">API docs</a>
      <a href="/changelog.html" data-nav="changelog">Changelog</a>
    </div>
    <div class="nav-cta">
      <a href="/workspace.html" class="btn-ghost-nav">Sign in</a>
      <a href="/pricing.html" class="btn-primary-nav">Get early access →</a>
    </div>
    <button class="nav-mobile-toggle" id="navToggle" aria-label="Toggle menu"><i class="ti ti-menu-2"></i></button>
  </div>
</nav>
<script>
(function(){if(window.__sfNavBound)return;window.__sfNavBound=true;
document.addEventListener('click',function(e){
  var b=e.target.closest?e.target.closest('#navToggle'):null;if(!b)return;
  var l=document.querySelector('.nav-links');if(!l)return;
  l.classList.toggle('open');
  var i=b.querySelector('i');if(i)i.className=l.classList.contains('open')?'ti ti-x':'ti ti-menu-2';
});})();
</script>
<!--CHROME:HEADER:END-->
<div class="auth-wrap">
  <div class="card">
    <div class="logo">
      <div class="logomark"><div class="star"></div></div>
      <div class="wordmark">Spora<span>Find</span></div>
    </div>
    <h1>Investor Portal</h1>
    <p class="sub">Access the Sporafind pitch deck, financial model, metrics dashboard, and data room.</p>

    <div class="steps">
      <div class="step"><span class="step-num">1</span> Enter your email to request access</div>
      <div class="step"><span class="step-num">2</span> We'll verify and send your portal link</div>
      <div class="step"><span class="step-num">3</span> View deck, financials, and data room</div>
    </div>

    <div id="loginForm">
      <div class="form-group">
        <label>Full name</label>
        <input type="text" id="investorName" placeholder="Your name" autocomplete="name">
      </div>
      <div class="form-group">
        <label>Email address</label>
        <input type="email" id="investorEmail" placeholder="you@firm.com" autocomplete="email">
      </div>
      <div class="form-group">
        <label>Company (optional)</label>
        <input type="text" id="investorCompany" placeholder="Your investment firm">
      </div>
      <button class="btn" id="investorLoginBtn" onclick="doInvestorLogin()"><i class="ti ti-login"></i> Request Access</button>
      <div class="error" id="investorLoginError"><i class="ti ti-alert-circle"></i> <span id="investorLoginErrorText">Please check your details and try again.</span></div>
      <div class="success" id="investorLoginSuccess">Access granted — redirecting to your dashboard...</div>
    </div>

    <div class="divider">or</div>
    <button class="btn btn-outline" onclick="demoLogin()"><i class="ti ti-flask"></i> Demo Access (Instant)</button>

    <div class="demo-hint">
      Already have access? <a href="/investors/dashboard">Go to dashboard →</a>
    </div>
  </div>
</div>

<script>
async function doInvestorLogin() {
  const name = document.getElementById('investorName').value.trim();
  const email = document.getElementById('investorEmail').value.trim();
  const company = document.getElementById('investorCompany').value.trim();
  const errEl = document.getElementById('investorLoginError');
  const errText = document.getElementById('investorLoginErrorText');
  const btn = document.getElementById('investorLoginBtn');

  if (!name || !email) {
    errText.textContent = 'Name and email are required.';
    errEl.classList.add('show');
    return;
  }

  btn.disabled = true;
  btn.innerHTML = '<i class="ti ti-loader"></i> Requesting...';
  errEl.classList.remove('show');

  try {
    const r = await fetch('/api/investor/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, name, role: 'investor' }),
    });
    const data = await r.json();
    if (!r.ok) {
      errText.textContent = data.detail || 'Signup failed';
      errEl.classList.add('show');
      btn.disabled = false;
      btn.innerHTML = '<i class="ti ti-login"></i> Request Access';
      return;
    }
    localStorage.setItem('sf_investor_token', data.token);
    localStorage.setItem('sf_investor_user', JSON.stringify(data));
    document.getElementById('loginForm').style.display = 'none';
    document.getElementById('investorLoginSuccess').classList.add('show');
    setTimeout(() => { window.location.href = '/investors/dashboard'; }, 1000);
  } catch(e) {
    errText.textContent = 'Could not connect to server.';
    errEl.classList.add('show');
    btn.disabled = false;
    btn.innerHTML = '<i class="ti ti-login"></i> Request Access';
  }
}

async function demoLogin() {
  const demoEmail = 'investor@sporafind.com';
  const demoName = 'Demo Investor';
  try {
    const r = await fetch('/api/investor/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: demoEmail, name: demoName, role: 'investor' }),
    });
    const data = await r.json();
    if (r.ok) {
      localStorage.setItem('sf_investor_token', data.token);
      localStorage.setItem('sf_investor_user', JSON.stringify(data));
      window.location.href = '/investors/dashboard';
    }
  } catch(e) {}
}
</script>
