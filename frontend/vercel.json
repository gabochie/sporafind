{
  "cleanUrls": true,
  "functions": {
    "api/server.js": { "runtime": "nodejs20.x" }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ],
  "rewrites": [    { "source": "/blog/:path*", "destination": "/api/server.js" },
    { "source": "/api/:path*", "destination": "/api/server.js" },
    { "source": "/sitemap.xml", "destination": "/api/server.js" },
    { "source": "/rss.xml", "destination": "/api/server.js" },
    { "source": "/investors/:path*", "destination": "/api/server.js" },
    { "source": "/workspace/:path*", "destination": "/api/server.js" }
  ]
}
