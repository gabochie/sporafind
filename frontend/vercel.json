{
  "builds": [
    { "src": "api/server.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "js/*", "use": "@vercel/static" },
    { "src": "css/*", "use": "@vercel/static" },
    { "src": "img/*", "use": "@vercel/static" },
    { "src": "icons/*", "use": "@vercel/static" },
    { "src": "data/*", "use": "@vercel/static" }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ],
  "routes": [
    { "src": "/sw.js", "headers": { "Cache-Control": "no-store, must-revalidate" }, "continue": true },
    { "src": "/sitemap\\.xml", "dest": "api/server.js" },
    { "src": "/rss\\.xml", "dest": "api/server.js" },
    { "src": "/blog(/.*)?", "dest": "api/server.js" },
    { "src": "/api(/.*)?", "dest": "api/server.js" },
    { "src": "/investors(/.*)?", "dest": "api/server.js" },
    { "src": "/workspace(/.*)?", "dest": "api/server.js" }
  ]
}