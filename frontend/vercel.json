{
  "builds": [
    { "src": "api/server.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "js/*", "use": "@vercel/static" },
    { "src": "data/*", "use": "@vercel/static" }
  ],
  "cleanUrls": true,
  "routes": [
    { "src": "/blog(/.*)?", "dest": "api/server.js" },
    { "src": "/api(/.*)?", "dest": "api/server.js" },
    { "src": "/sitemap\\.xml", "dest": "api/server.js" },
    { "src": "/rss\\.xml", "dest": "api/server.js" },
    { "src": "/investors(/.*)?", "dest": "api/server.js" }
  ]
}
