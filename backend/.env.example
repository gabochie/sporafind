# Database — use the Supabase pooler (port 6543) for serverless/Vercel.
# Direct connection (port 5432) is IPv6-only on some networks and breaks asyncpg.
# Get the pooler URL from Supabase Dashboard → Settings → Database → Connection pooling.
DATABASE_URL=postgresql+asyncpg://postgres.YOUR-PROJECT-REF:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Optional: direct (non-pooled) URL for migrations only
DIRECT_URL=postgresql+asyncpg://postgres:password@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Supabase (for direct client usage if needed)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Test database (CI / local pytest)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sporafind_test

# Cache / jobs
REDIS_URL=redis://localhost:6379

# Companies House API
COMPANIES_HOUSE_API_KEY=your-api-key

# OpenCorporates API (for US diaspora scraping)
OPEN_CORPORATES_API_KEY=your-api-key

# Auth
AUTH_SECRET=generate-a-random-secret-here

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:3001,https://sporafind.com,https://www.sporafind.com,https://api.sporafind.com

# Admin
ADMIN_KEY=your-admin-key

# Public API key (optional — if set, required on all public read endpoints via X-API-Key header)
PUBLIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# Web Push (VAPID — generate once: python -c "from pywebpush import vapid; ...")
# Public key is also exposed to the frontend via GET /push/vapid-key
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@sporafind.com

# Environment
ENVIRONMENT=development
