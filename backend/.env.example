# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres

# Supabase (for direct client usage if needed)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Companies House API
COMPANIES_HOUSE_API_KEY=your-api-key

# Auth
AUTH_SECRET=generate-a-random-secret-here

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,https://sporafind.com

# Admin
ADMIN_KEY=your-admin-key

# Public API key (optional — if set, required on all public read endpoints via X-API-Key header)
PUBLIC_API_KEY=

# Environment
ENVIRONMENT=development
